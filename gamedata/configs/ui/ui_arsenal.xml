<?xml version="1.0" encoding="windows-1251"?>
<!--
    Arsenal's page in the PDA. Laid out like the PDA's own Guide (pda_encyclopedia_16.xml):
    categories, a list, and the entry, side by side, in the free content box every PDA page
    uses, (28,106)-(792,709) of the 1024x768 PDA frame. Colors are arsenal_theme's palette:
    heading 238,196,112; body 200,200,200; dim 140,140,140.
-->
<w>
	<!-- the flat window (arsenal_mcm's key): the 2D PDA's frame and caption, where pda_16.xml
	     puts them relative to the PDA's pages -->
	<flat_bezel x="-10" y="-34" width="819" height="768" stretch="1">
		<texture>ui_inGame2_pda_texture</texture>
	</flat_bezel>
	<flat_caption x="29" y="28" width="748" height="17">
		<text font="letterica16" align="l" r="170" g="170" b="170">st_arsenal_title</text>
	</flat_caption>

	<!-- header row, the same on both pages: the switch between the catalog and Workbench (the
	     page shown pressed), the page's line, its button, Back -->
	<page_catalog x="28" y="107" width="92" height="26" stretch="1" check_mode="0">
		<texture>ui_button_ordinary</texture>
		<text font="letterica16" align="c" vert_align="c">st_arsenal_title</text>
	</page_catalog>
	<page_workbench x="122" y="107" width="92" height="26" stretch="1" check_mode="0">
		<texture>ui_button_ordinary</texture>
		<text font="letterica16" align="c" vert_align="c">st_arsenal_workbench</text>
	</page_workbench>
	<found_count x="224" y="110" width="318" height="20">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
	</found_count>
	<btn_back x="672" y="107" width="120" height="26" stretch="1" check_mode="0">
		<texture>ui_button_ordinary</texture>
		<text font="letterica16" align="c" vert_align="c">st_arsenal_back</text>
	</btn_back>
	<!-- the button for the model shown: Workbench's Customize, or another app's
	     (ui_arsenal.add_action); hidden while none applies -->
	<action_btn x="546" y="107" width="120" height="26" stretch="1" check_mode="0">
		<texture>ui_button_ordinary</texture>
		<text font="letterica16" align="c" vert_align="c"/>
	</action_btn>
	<rule_top x="28" y="139" width="764" height="1" stretch="1">
		<texture>arsenal_rule</texture>
	</rule_top>

	<!-- columns. The left one lists the categories, or with "By faction" ticked every faction's
	     gear; the toggle sits over it like "Found only" -->
	<by_faction_lbl x="32" y="146" width="96" height="20">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c">st_arsenal_by_faction</text>
	</by_faction_lbl>
	<by_faction x="130" y="141" width="30" height="30" stretch="1">
		<texture>ui_inGame2_checkbox</texture>
	</by_faction>
	<cat_list x="28" y="174" width="132" height="532" item_height="22" can_select="1" always_show_scroll="0">
		<font font="letterica16" r="200" g="200" b="200"/>
	</cat_list>
	<rule_cat x="164" y="146" width="1" height="560" stretch="1">
		<texture>arsenal_rule</texture>
	</rule_cat>
	<!-- over the model list, like "By faction" over the left one -->
	<found_only_lbl x="174" y="146" width="96" height="20">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c">st_arsenal_found_only</text>
	</found_only_lbl>
	<found_only x="272" y="141" width="30" height="30" stretch="1">
		<texture>ui_inGame2_checkbox</texture>
	</found_only>
	<wpn_list x="170" y="174" width="250" height="532" item_height="22" can_select="1" always_show_scroll="0">
		<font font="letterica16" r="200" g="200" b="200"/>
	</wpn_list>
	<rule_wpn x="424" y="146" width="1" height="560" stretch="1">
		<texture>arsenal_rule</texture>
	</rule_wpn>
	<detail x="432" y="146" width="360" height="560" always_show_scroll="0" stretch="1"/>

	<!-- the entry, built per weapon inside the detail scroll view; 344 wide leaves room for its bar -->
	<entry x="0" y="0" width="344" height="560" stretch="1"/>
	<!-- a panel a little lighter than the PDA, behind the icon: arsenal_rule (90 gray) at 160/255 -->
	<entry_icon_bg x="0" y="2" width="344" height="118" stretch="1">
		<texture r="160" g="160" b="160">arsenal_rule</texture>
	</entry_icon_bg>
	<entry_icon_frame x="8" y="8" width="328" height="106" stretch="1"/>
	<entry_icon x="0" y="0" width="10" height="10" stretch="1"/>
	<entry_name x="0" y="126" width="344" height="20">
		<text font="letterica18" r="238" g="196" b="112" align="l" vert_align="t" complex_mode="1"/>
	</entry_name>
	<entry_found x="0" y="146" width="344" height="18">
		<text font="letterica16" r="140" g="140" b="140" align="l" vert_align="t" complex_mode="1"/>
	</entry_found>
	<entry_rule x="0" y="0" width="344" height="1" stretch="1">
		<texture>arsenal_rule</texture>
	</entry_rule>
	<entry_heading x="0" y="0" width="344" height="20">
		<text font="letterica18" r="238" g="196" b="112" align="l" vert_align="c"/>
	</entry_heading>
	<entry_line x="0" y="0" width="344" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</entry_line>
	<!-- a stat's fully upgraded value, right of the card's value (child of the card's row) -->
	<entry_max x="250" y="2" width="94" height="16">
		<text font="letterica16" r="140" g="140" b="140" align="l" vert_align="t"/>
	</entry_max>
	<!-- R.I.S.K. enhancements: a family, and the stat with one of its enhancements -->
	<risk_name x="0" y="0" width="124" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</risk_name>
	<risk_values x="128" y="0" width="216" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</risk_values>
	<!-- where to find it: a faction, and the ranks of its fighters that carry the gun -->
	<where_faction x="0" y="0" width="84" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</where_faction>
	<where_ranks x="88" y="0" width="256" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</where_ranks>
	<!-- a gun's rounds, a row each: the name, then four numbers in columns the script places
	     (round_cols: damage, AP, speed, damage left at 100 m), right-aligned -->
	<round_name x="0" y="0" width="140" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</round_name>
	<round_cell x="0" y="0" width="46" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="r" vert_align="t"/>
	</round_cell>
	<!-- a round's own values: what, then how much -->
	<round_stat x="0" y="0" width="150" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</round_stat>
	<round_value x="154" y="0" width="190" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</round_value>

	<!-- what fits the gun: tiles three to a row (108 wide, 10 apart), the icon on a panel like
	     the gun's, the name under it, a note (grenades, the gun a kit makes) under that -->
	<tile_icon_frame x="0" y="0" width="108" height="56" stretch="1">
		<texture r="160" g="160" b="160">arsenal_rule</texture>
	</tile_icon_frame>
	<tile_name x="0" y="0" width="108" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="c" vert_align="t" complex_mode="1"/>
	</tile_name>
	<tile_note x="0" y="0" width="108" height="18">
		<text font="letterica16" r="140" g="140" b="140" align="c" vert_align="t" complex_mode="1"/>
	</tile_note>
	<!-- parts: a row each, the icon on a panel, the name beside it -->
	<part_icon_frame x="0" y="0" width="64" height="30" stretch="1">
		<texture r="160" g="160" b="160">arsenal_rule</texture>
	</part_icon_frame>
	<part_name x="72" y="0" width="272" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</part_name>
	<!-- camos: a part's row, the camo's swatch in the panel, a note under the name -->
	<camo_swatch x="0" y="0" width="24" height="24" stretch="1"/>
	<camo_note x="72" y="0" width="272" height="18">
		<text font="letterica16" r="140" g="140" b="140" align="l" vert_align="t" complex_mode="1"/>
	</camo_note>

	<!-- list rows: 22 high, as the Guide's; a gun's name may carry a tag, so the gun list is the wide one -->
	<row_name x="4" y="0" width="240" height="22">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
	</row_name>
	<row_count x="0" y="0" width="126" height="22">
		<text font="letterica16" r="140" g="140" b="140" align="r" vert_align="c"/>
	</row_count>
	<!-- a new row's glow behind its name, as wide as its list; the script tints and pulses it -->
	<cat_glow x="0" y="1" width="132" height="20" stretch="1">
		<texture>arsenal_glow</texture>
	</cat_glow>
	<wpn_glow x="0" y="1" width="250" height="20" stretch="1">
		<texture>arsenal_glow</texture>
	</wpn_glow>

	<!-- the new count on Arsenal's tile in MAC's launcher (z_arsenal_mac): one shape per number of
	     digits, sized and tinted by the script -->
	<mac_badge x="0" y="0" width="20" height="20" stretch="1">
		<texture>arsenal_badge_1</texture>
	</mac_badge>
	<mac_badge_text x="0" y="0" width="20" height="20">
		<text font="letterica16" r="255" g="255" b="255" align="c" vert_align="c"/>
	</mac_badge_text>

	<!-- ============ Workbench, the second page (ui_arsenal_workbench) ============
	     The header as the catalog's: the switch, the item's name where the catalog has its
	     count, Clear, Install, Back. Left: the items, then the card and the attachments.
	     Right: GAMMA's upgrade tree in its toolkit's panel and cells, the kits, the details. -->
	<wb_title x="224" y="110" width="316" height="20">
		<text font="letterica18" r="238" g="196" b="112" align="l" vert_align="c"/>
	</wb_title>
	<wb_install x="546" y="107" width="120" height="26" stretch="1" check_mode="0">
		<texture>ui_button_ordinary</texture>
		<text font="letterica16" align="c" vert_align="c">st_arsenal_wb_install</text>
	</wb_install>

	<wb_list x="28" y="146" width="240" height="176" item_height="22" can_select="1" always_show_scroll="0">
		<font font="letterica16" r="200" g="200" b="200"/>
	</wb_list>
	<wb_row_name x="4" y="0" width="200" height="22">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
	</wb_row_name>
	<wb_row_count x="0" y="0" width="226" height="22">
		<text font="letterica16" r="238" g="196" b="112" align="r" vert_align="c"/>
	</wb_row_count>
	<wb_rule_list x="28" y="326" width="240" height="1" stretch="1">
		<texture>arsenal_rule</texture>
	</wb_rule_list>
	<!-- the card, built for each item: a row is the card's icon, its name, and "now >> planned" -->
	<wb_card x="28" y="332" width="244" height="228" always_show_scroll="0" stretch="1"/>
	<wb_card_box x="0" y="0" width="240" height="228" stretch="1"/>
	<wb_card_icon x="0" y="0" width="16" height="16" stretch="1"/>
	<wb_card_name x="20" y="0" width="106" height="20">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
	</wb_card_name>
	<!-- the value now, the arrow and the planned value, each its own text (one wrapped text with
	     color codes loses its second line); a value the plan leaves alone shows in the last -->
	<wb_card_now x="126" y="0" width="52" height="20">
		<text font="letterica16" r="200" g="200" b="200" align="r" vert_align="c"/>
	</wb_card_now>
	<wb_card_to x="178" y="0" width="12" height="20">
		<text font="letterica16" r="140" g="140" b="140" align="c" vert_align="c"/>
	</wb_card_to>
	<wb_card_plan x="190" y="0" width="50" height="20">
		<text font="letterica16" r="200" g="200" b="200" align="r" vert_align="c"/>
	</wb_card_plan>
	<wb_line x="0" y="0" width="240" height="18">
		<text font="letterica16" r="140" g="140" b="140" align="l" vert_align="t" complex_mode="1"/>
	</wb_line>
	<!-- a gun's attachments: three rows of a name over a button that steps through what fits,
	     the script places them 46 apart; a suit's card takes their room -->
	<wb_att_lbl x="28" y="566" width="240" height="18">
		<text font="letterica16" r="140" g="140" b="140" align="l" vert_align="c"/>
	</wb_att_lbl>
	<wb_att_btn x="28" y="584" width="240" height="26" stretch="1" check_mode="0">
		<texture>ui_button_ordinary</texture>
		<text font="letterica16" align="c" vert_align="c"/>
	</wb_att_btn>

	<!-- the tree, in the toolkit's panel (ui_workshop_16.xml: its Upgrade tab's numbers) -->
	<wb_tree_bg x="276" y="146" width="516" height="380" stretch="1">
		<texture>ui_inGame2_workshop_upgrade_menu</texture>
	</wb_tree_bg>
	<wb_tree x="284" y="150" width="504" height="372" right_ident="0" left_ident="0" top_indent="0" bottom_indent="0"
		vert_interval="0" always_show_scroll="0"/>
	<wb_form x="0" y="0" width="454" height="120" stretch="1"/>
	<wb_form_idx x="0" y="0" width="31" height="120">
		<text font="letterica18" r="200" g="200" b="200" align="c" vert_align="c"/>
	</wb_form_idx>
	<!-- a cell, placed by the script: the kit's frame, icon and count, the upgrade's picture, its
	     state (green installed, yellow planned, red a second visit, dark shut), the button -->
	<wb_kit_frame x="0" y="0" width="56" height="44" stretch="1">
		<texture>ui_inGame2_workshop_item_window_clean_s</texture>
	</wb_kit_frame>
	<wb_kit_icon x="0" y="0" width="46" height="36" stretch="1"/>
	<wb_kit_num x="0" y="0" width="16" height="16">
		<text font="letterica16" r="150" g="150" b="150" align="r" vert_align="c"/>
	</wb_kit_num>
	<wb_pic x="0" y="0" width="72" height="44" stretch="1"/>
	<wb_mark x="0" y="0" width="72" height="44" stretch="1"/>
	<wb_cell x="0" y="0" width="72" height="44" stretch="1" check_mode="0"/>

	<!-- the kits the plan takes: a frame each (the script places them 52 apart), the kit's icon,
	     "needed/held"; then Clear -->
	<wb_kits_lbl x="280" y="532" width="60" height="44">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
	</wb_kits_lbl>
	<wb_kits_frame x="342" y="530" width="48" height="48" stretch="1">
		<texture>ui_inGame2_workshop_item_window_clean_s</texture>
	</wb_kits_frame>
	<wb_kits_icon x="0" y="0" width="44" height="30" stretch="1"/>
	<wb_kits_num x="342" y="560" width="48" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="c" vert_align="c"/>
	</wb_kits_num>
	<wb_clear x="672" y="541" width="120" height="26" stretch="1" check_mode="0">
		<texture>ui_button_ordinary</texture>
		<text font="letterica16" align="c" vert_align="c">st_arsenal_wb_clear</text>
	</wb_clear>
	<wb_rule_info x="276" y="584" width="516" height="1" stretch="1">
		<texture>arsenal_rule</texture>
	</wb_rule_info>
	<!-- the details: the upgrade or attachment under the cursor, else the plan -->
	<wb_info x="280" y="590" width="512" height="116" always_show_scroll="0" stretch="1"/>
	<wb_info_box x="0" y="0" width="496" height="116" stretch="1"/>
	<wb_info_name x="0" y="0" width="496" height="20">
		<text font="letterica18" r="238" g="196" b="112" align="l" vert_align="t" complex_mode="1"/>
	</wb_info_name>
	<wb_info_line x="0" y="0" width="496" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</wb_info_line>
</w>
