--[[
    Arsenal data: every weapon of the running game, read from its own configs (system.ltx and
    all it includes, after DLTX), so the catalog matches whatever mod list the player has.

    A weapon is listed when its kind is a weapon kind (or its class is WP_KNIFE), it is its own
    parent_section (a scope or silencer combination names the gun it was made from), and it
    has a name and an inventory icon. Multiplayer sections, the knives' attack animations and
    a few leftovers that look like weapons but are not are skipped.

    Guns that share a name are sorted out here. Those that play the same (same ammo, fire
    modes, magazine, rate of fire, damage, accuracy, handling, bullet speed, reliability,
    recoil, weight and built-in or attachable parts) are one entry, and finding any of them
    finds it. The rest get tags from the differences that tell them apart, in the order a
    player cares about: caliber, a built-in suppressor or scope, a grenade launcher, auto
    fire, magazine, rate of fire, the stat card's values, weight, then mounts. Only guns that
    still clash get the next tag; what no tag separates is numbered.

    Stats come from the game's own weapon stat card, utils_ui.stats_table.weapon, as GAMMA
    sets it up: the same rows, order, icons, names and units as the inventory tooltip. A row
    whose function needs a live weapon (Momopate's bullet speed, reliability, recoil) gets a
    stand-in here that reads the same values from the section alone.
--]]

-- categories in display order: weapons by kind, then armor by GAMMA's armor class (its repair
-- type, which also picks the repair kits) and helmets
CATEGORIES = { "pistols", "smgs", "shotguns", "rifles", "snipers", "launchers", "melee",
    "light", "medium", "heavy", "exo", "helmets" }
ARMOR = { light = true, medium = true, heavy = true, exo = true, helmets = true }
local KIND = {
    w_pistol = "pistols", w_smg = "smgs", w_shotgun = "shotguns", w_rifle = "rifles",
    w_sniper = "snipers", w_explosive = "launchers", w_melee = "melee",
}
-- suits and helmets: their engine classes, and their kinds (a section of an armor class
-- without one is a template)
local ARMOR_CLASS = { E_STLK = true, EQU_STLK = true, E_HLMET = true }
local ARMOR_KIND = { o_light = "light", o_medium = "medium", o_sci = "medium", o_heavy = "heavy", o_helmet = "helmets" }
local ARMOR_REPAIR = { outfit_novice = "light", outfit_light = "light", outfit_medium = "medium",
    outfit_heavy = "heavy", outfit_exo = "exo" }
-- sections that look like weapons but are not items
local SKIP = { wpn_addon_silencer = true, wpn_addon_scope = true }

local by_var, by_cat, total = nil, nil, 0

local function translated(key)
    if not key or key == "" then return nil end
    local s = game.translate_string(key)
    return (s ~= key) and s or nil
end

-- whether a suit or helmet section is a helmet
function is_helmet(sec)
    return ini_sys:r_string_ex(sec, "class") == "E_HLMET" or ini_sys:r_string_ex(sec, "kind") == "o_helmet"
end

-- the category a section is listed under, or nil
function category_of(sec)
    if SKIP[sec] or sec:find("^mp_") or sec:find("^animation_") then return nil end
    local kind = ini_sys:r_string_ex(sec, "kind")
    if ARMOR_CLASS[ini_sys:r_string_ex(sec, "class") or ""] then
        if not (kind and ARMOR_KIND[kind]) then return nil end
        if not translated(ini_sys:r_string_ex(sec, "inv_name")) then return nil end
        if not ini_sys:r_float_ex(sec, "inv_grid_x") then return nil end
        return is_helmet(sec) and "helmets" or ARMOR_REPAIR[ini_sys:r_string_ex(sec, "repair_type") or ""]
            or ARMOR_KIND[kind]
    end
    local cat = kind and KIND[kind]
    if not cat and ini_sys:r_string_ex(sec, "class") == "WP_KNIFE" then
        cat = "melee"
    end
    if not cat then return nil end
    local parent = ini_sys:r_string_ex(sec, "parent_section")
    if parent and parent ~= sec then return nil end              -- a combination of another gun
    if cat == "launchers" and not ini_sys:r_string_ex(sec, "weapon_class") then
        return nil                                                -- a grenade, not a launcher
    end
    if not translated(ini_sys:r_string_ex(sec, "inv_name")) then return nil end
    if not ini_sys:r_float_ex(sec, "inv_grid_x") then return nil end
    return cat
end

local function by_name(a, b)
    if a.name ~= b.name then return a.name < b.name end
    return a.sec < b.sec
end

-- a field as the engine reads it: r_float_ex is the engine's atof, so "1.0f" is 1 and a list
-- gives its first value
local function num(sec, key)
    local n = ini_sys:r_float_ex(sec, key)
    return n and string.format("%.4g", n) or ""
end

-- the ammo a gun chambers, worn rounds left out, in a fixed order
local function ammo_key(sec)
    local list = {}
    for a in (ini_sys:r_string_ex(sec, "ammo_class") or ""):gmatch("[^,%s]+") do
        if not (a:find("_bad$") or a:find("_verybad$")) then
            list[#list + 1] = a
        end
    end
    table.sort(list)
    return table.concat(list, ",")
end

-- the items of a comma list in a section
local function each_of(sec, key)
    return (ini_sys:r_string_ex(sec, key) or ""):gmatch("[^,%s]+")
end

-- what makes two guns of one name play differently
local SAME = { "ammo_mag_size", "rpm", "hit_power", "fire_dispersion_base", "PDM_disp_base",
    "control_inertion_factor", "bullet_speed", "condition_shot_dec", "zoom_cam_dispersion",
    "silencer_status", "scope_status", "grenade_launcher_status", "inv_weight" }

function signature(sec, cat)
    if ARMOR[cat or ""] then return armor_signature(sec) end
    local t = { ammo_key(sec), ((ini_sys:r_string_ex(sec, "fire_modes") or ""):gsub("%s", "")) }
    for _, k in ipairs(SAME) do
        t[#t + 1] = num(sec, k)
    end
    local up = {}
    for u in each_of(sec, "installed_upgrades") do
        up[#up + 1] = u
    end
    table.sort(up)
    t[#t + 1] = table.concat(up, ",")
    return table.concat(t, "|")
end

local function status(sec, key)
    return math.floor(ini_sys:r_float_ex(sec, key) or 0)
end

local function tag(id, ...)
    return string.format(game.translate_string(id), ...)
end

-- the caliber, from the first ammo's name: its first word with a digit in it ("9x19", ".45";
-- a Russian name may open with a word for "cartridges"), else its first word
local function caliber(sec)
    local a = (ini_sys:r_string_ex(sec, "ammo_class") or ""):match("^%s*([^,%s]+)")
    local n = a and (translated(ini_sys:r_string_ex(a, "inv_name_short"))
        or translated(ini_sys:r_string_ex(a, "inv_name")))
    if not n then return nil end
    for w in n:gmatch("%S+") do
        if w:find("%d") then return w end
    end
    return n:match("^(%S+)")
end

local function first_ammo(sec)
    local ok, list = pcall(utils_item.get_ammo, sec, nil)
    return ok and list and list[1]
end

local function value(sec, key)
    return ini_sys:r_float_ex(sec, key) or 0
end

local function above0(d)
    return d < 0 and 0 or d
end

-- A gun's values as the stat card reads them for a section: its own plus the upgrades it
-- ships with, which utils_item.get_param adds (a pre-upgraded variant's card shows them).
PARAMS = { "fire_dispersion_base", "PDM_disp_base", "control_inertion_factor", "rpm",
    "ammo_mag_size", "bullet_speed", "condition_shot_dec", "zoom_cam_dispersion" }

function params(sec)
    local p = { sec = sec }
    for _, k in ipairs(PARAMS) do
        local ok, v = pcall(utils_item.get_param, sec, nil, k, "float", true)
        p[k] = (ok and tonumber(v)) or ini_sys:r_float_ex(sec, k) or 0
    end
    return p
end

-- Momopate's bullet speed (as a fraction of 1000 m/s) and recoil control (nil without a recoil
-- profile) from a gun's values; momopate_weaponstats.script
local function bspeed(p)
    local bs = p.bullet_speed
    local ammo = first_ammo(p.sec)
    if ammo then
        local k = ini_sys:r_float_ex(ammo, "k_bullet_speed") or 1
        bs = (bs ~= 0) and (k * bs) or k
        bs = bs * 0.70
    end
    return normalize(bs, 0, 1000)
end

local ini_recoil
local function numbers(s, out)
    for n in (s or ""):gmatch("[^,:%s]+") do
        out[#out + 1] = tonumber(n)
    end
    return out
end

local function recoil(p)
    ini_recoil = ini_recoil or ini_file("plugins\\grok_bo_enhanced_recoil.ltx")
    local prof = ini_sys:r_string_ex(p.sec, "parent_section") or p.sec
    if not ini_recoil:section_exist(prof) then return nil end
    local s = numbers(ini_recoil:r_string_ex(prof, "s"), {})
    local e = {}
    for _, v in ipairs(numbers(ini_recoil:r_string_ex(prof, "e"), {})) do
        if v > 0 then e[#e + 1] = v end
    end
    local zcd = p.zoom_cam_dispersion
    if #s == 0 or zcd <= 0 then return nil end
    local mean = 0
    for _, v in ipairs(s) do mean = mean + v end
    mean = mean / #s
    local r = (1 / zcd) * (1 / (3 * mean + (e[2] or 1))) * 100
    return math.max(1, r)
end

-- A stat as the inventory's stat card shows it (utils_ui and ish_item_stats), from a gun's
-- values: the same formula in the same order, rounded the same way, so a tag or a maximum
-- reads like the card. Keyed by the card's row names. The percentages stop at 100: stacked
-- upgrades can take a dispersion past zero in the configs, which no gun reaches in play.
CARD = {
    accuracy = function(p)
        return math.min(100, math.floor(above0((p.fire_dispersion_base - 1.5) / (0 - 1.5)) * 100))
    end,
    handling = function(p)
        return math.min(100, math.floor((above0((p.PDM_disp_base - 2.1) / (0 - 2.1))
            + above0((p.control_inertion_factor - 3) / (1 - 3))) / 2 * 100))
    end,
    fire_rate = function(p)
        return math.ceil(above0((p.rpm - 0) / (1000 - 0)) * 1000)
    end,
    ammo_mag_size = function(p)
        return math.ceil(p.ammo_mag_size)
    end,
    speed = function(p)
        return math.ceil(bspeed(p) * 1000)
    end,
    reliability = function(p)
        return math.min(100, math.ceil((1.0 - p.condition_shot_dec - 0.99) * 10000))
    end,
    recoil = function(p)
        local r = recoil(p)
        return r and math.ceil(r)
    end,
    damage = function(p)
        local hp, ammo = value(p.sec, "hit_power"), first_ammo(p.sec)
        if ammo then
            local k = ini_sys:r_float_ex(ammo, "k_hit") or 1
            hp = (hp ~= 0) and (k * hp) or k
        end
        return math.floor(above0(hp / 1.5) * 100)
    end,
}

-- The upgrade tree of a section. Its "upgrades" name the first groups; a group's "elements"
-- are the upgrades to choose between, one per group; an upgrade's "effects" open more groups
-- and its "section" holds the changes the game adds to the gun's values. Returns the groups,
-- each a list of { ps = change section, prop = property, installed = the gun ships with it },
-- `fixed` when the gun ships an upgrade of the group. Kept per section: the configs do not
-- change while the game runs, and a page asks for a tree once per stat.
-- R.I.S.K.'s enhancement groups are no mechanic's upgrades (its kits install them, one gun at a
-- time), though its test file lists them in a few guns' "upgrades"
local NOT_UPGRADES = "^risk_"

local trees = {}
function upgrade_tree(sec)
    if trees[sec] then return trees[sec] end
    local installed, groups, seen, queue = {}, {}, {}, {}
    for u in each_of(sec, "installed_upgrades") do
        installed[u] = true
    end
    for g in each_of(sec, "upgrades") do
        if not g:find(NOT_UPGRADES) then queue[#queue + 1] = g end
    end
    local i = 1
    while queue[i] do
        local g = queue[i]
        i = i + 1
        if not seen[g] and ini_sys:section_exist(g) then
            seen[g] = true
            local group = { fixed = false }
            for el in each_of(g, "elements") do
                if ini_sys:section_exist(el) then
                    for nxt in each_of(el, "effects") do
                        queue[#queue + 1] = nxt
                    end
                    local inst = installed[el] == true
                    group.fixed = group.fixed or inst
                    local ps = ini_sys:r_string_ex(el, "section")
                    if ps and ini_sys:section_exist(ps) then
                        group[#group + 1] = { ps = ps, prop = ini_sys:r_string_ex(el, "property") or "", installed = inst }
                    end
                end
            end
            if #group > 0 then
                groups[#groups + 1] = group
            end
        end
    end
    trees[sec] = groups
    return groups
end

local function calibre(u)
    return u.prop:find("prop_calibre", 1, true) ~= nil
end

-- The upgrades open to a fully upgraded gun, by group, as lists of change sections: a group
-- the gun ships an upgrade in is already in its values (params) and left out, and a caliber
-- conversion trades one stat for another and is no upgrade.
function upgrade_groups(sec)
    local out = {}
    for _, g in ipairs(upgrade_tree(sec)) do
        if not g.fixed then
            local opts = {}
            for _, u in ipairs(g) do
                if not calibre(u) then opts[#opts + 1] = u.ps end
            end
            if #opts > 0 then out[#out + 1] = opts end
        end
    end
    return out
end

-- A stat card value of a section fully upgraded: in every group, the upgrade that raises it
-- most, or none. Returns the maximum and the value as it is, or nil for a stat the card
-- formulas here do not cover.
function max_stat(sec, stat)
    if is_armor(sec) then return armor_max(sec, stat) end
    local f = CARD[stat]
    if not f or stat == "damage" then return nil end
    local p = params(sec)
    local base = f(p)
    if base == nil then return nil end
    local cur = base
    for _, opts in ipairs(upgrade_groups(sec)) do
        local pick
        for _, ps in ipairs(opts) do
            local q = {}
            for k, v in pairs(p) do
                q[k] = v
            end
            for _, k in ipairs(PARAMS) do
                local d = ini_sys:r_float_ex(ps, k)
                if d then q[k] = q[k] + d end
            end
            local v = f(q)
            if v and v > cur then
                cur, pick = v, q
            end
        end
        if pick then p = pick end
    end
    return cur, base
end

-- What tells guns of one name apart, in the order a player cares about. A tagger returns the
-- tag, "" for a plain no (no suppressor), or nil when it cannot tell (no recoil profile), and
-- a gun it cannot tell about is no difference.
TAGGERS = {
    caliber,
    function(sec) return status(sec, "silencer_status") == 1 and tag("st_arsenal_tag_suppressed") or "" end,
    function(sec) return status(sec, "scope_status") == 1 and tag("st_arsenal_tag_scoped") or "" end,
    function(sec)
        local g = status(sec, "grenade_launcher_status")
        return g == 1 and tag("st_arsenal_tag_gl") or g == 2 and tag("st_arsenal_tag_gl_mount") or ""
    end,
    function(sec)
        return (ini_sys:r_string_ex(sec, "fire_modes") or ""):find("-1", 1, true) and tag("st_arsenal_tag_auto") or ""
    end,
    function(sec) return tag("st_arsenal_tag_rounds", CARD.ammo_mag_size(params(sec))) end,
    function(sec) return tag("st_arsenal_tag_rpm", CARD.fire_rate(params(sec))) end,
    function(sec) return tag("st_arsenal_tag_accuracy", CARD.accuracy(params(sec)) .. "%") end,
    function(sec) return tag("st_arsenal_tag_handling", CARD.handling(params(sec)) .. "%") end,
    function(sec) return tag("st_arsenal_tag_damage", CARD.damage(params(sec))) end,
    function(sec) return tag("st_arsenal_tag_speed", CARD.speed(params(sec))) end,
    function(sec) return tag("st_arsenal_tag_reliability", CARD.reliability(params(sec)) .. "%") end,
    function(sec)
        local r = CARD.recoil(params(sec))
        return r and tag("st_arsenal_tag_recoil", r)
    end,
    function(sec) return string.format("%s %s", tostring(kg(weight(sec))), game.translate_string("st_kg")) end,
    function(sec) return status(sec, "silencer_status") == 2 and tag("st_arsenal_tag_sup_mount") or "" end,
    function(sec) return status(sec, "scope_status") == 2 and tag("st_arsenal_tag_scope_mount") or "" end,
}

-- name the variants of one gun (or suit, with its own taggers): a tag only where variants
-- still clash, then numbers
local function label(name, reps, taggers)
    local tags = {}
    for _, e in ipairs(reps) do
        tags[e] = {}
    end
    local function clashing()
        local by, out = {}, {}
        for _, e in ipairs(reps) do
            local k = table.concat(tags[e], ", ")
            by[k] = by[k] or {}
            table.insert(by[k], e)
        end
        for _, g in pairs(by) do
            if #g > 1 then out[#out + 1] = g end
        end
        return out
    end
    for _, f in ipairs(taggers) do
        local groups = clashing()
        if #groups == 0 then break end
        for _, g in ipairs(groups) do
            local vals, first, differ, known = {}, nil, false, true
            for _, e in ipairs(g) do
                local ok, v = pcall(f, e.sec)
                if not ok or v == nil then
                    known = false
                    break
                end
                vals[e] = v
                if first == nil then
                    first = v
                elseif v ~= first then
                    differ = true
                end
            end
            if known and differ then
                for _, e in ipairs(g) do
                    if vals[e] ~= "" then table.insert(tags[e], vals[e]) end
                end
            end
        end
    end
    local base, seen, nth = {}, {}, {}
    for _, e in ipairs(reps) do
        base[e] = #tags[e] > 0 and string.format("%s (%s)", name, table.concat(tags[e], ", ")) or name
        seen[base[e]] = (seen[base[e]] or 0) + 1
    end
    for _, e in ipairs(reps) do
        if seen[base[e]] > 1 then
            nth[base[e]] = (nth[base[e]] or 0) + 1
            e.name = string.format("%s [%d]", base[e], nth[base[e]])
        else
            e.name = base[e]
        end
    end
end

local function shorter(a, b)
    if #a ~= #b then return #a < #b end
    return a < b
end

-- Build the catalog once per game (the configs do not change while it runs). An entry is one
-- gun model, all sections of one name in one category:
--     { sec = its first variant's section, cat, name, variants = { variant, ... } }
-- and a variant is the sections of that name that play the same, named by the shortest:
--     { sec, name = the name with its tags ("SKS (350 RPM)"), members = { section, ... }, entry }
-- A model's variants are sorted by name; a model of one variant has the plain name.
function build()
    if by_var then return end
    by_var, by_cat, total = {}, {}, 0
    for _, c in ipairs(CATEGORIES) do
        by_cat[c] = {}
    end
    local groups, order = {}, {}
    ini_sys:section_for_each(function(sec)
        local ok, cat = pcall(category_of, sec)
        if ok and cat then
            local name = translated(ini_sys:r_string_ex(sec, "inv_name"))
            local key = cat .. "|" .. name
            local g = groups[key]
            if not g then
                g = { cat = cat, name = name, buckets = {}, sigs = {} }
                groups[key] = g
                order[#order + 1] = key
            end
            local okS, sg = pcall(signature, sec, cat)
            sg = okS and sg or sec
            if not g.buckets[sg] then
                g.buckets[sg] = {}
                g.sigs[#g.sigs + 1] = sg
            end
            table.insert(g.buckets[sg], sec)
        end
    end)
    for _, key in ipairs(order) do
        local g, vars = groups[key], {}
        for _, sg in ipairs(g.sigs) do
            local secs = g.buckets[sg]
            table.sort(secs, shorter)
            vars[#vars + 1] = { sec = secs[1], name = g.name, members = secs }
        end
        if #vars > 1 then
            table.sort(vars, function(a, b) return a.sec < b.sec end)
            label(g.name, vars, ARMOR[g.cat] and ARMOR_TAGGERS or TAGGERS)
            table.sort(vars, by_name)
        end
        local e = { sec = vars[1].sec, cat = g.cat, name = g.name, variants = vars }
        for _, v in ipairs(vars) do
            v.entry = e
            for _, s in ipairs(v.members) do
                by_var[s] = v
            end
        end
        table.insert(by_cat[g.cat], e)
        total = total + 1
    end
    for _, c in ipairs(CATEGORIES) do
        table.sort(by_cat[c], by_name)
    end
end

-- the gun models of a category, by name
function list(cat)
    build()
    return by_cat[cat] or {}
end

-- the gun model a listed section belongs to
function get(sec)
    build()
    local v = sec and by_var[sec]
    return v and v.entry
end

-- the variant a listed section belongs to
function variant_of(sec)
    build()
    return sec and by_var[sec]
end

-- how many gun models
function count()
    build()
    return total
end

-- the variant a weapon in the world belongs to: a scoped or silenced combination counts as
-- the gun it was made from
function variant_for(sec)
    build()
    if not sec then return nil end
    local parent = ini_sys:r_string_ex(sec, "parent_section")
    return by_var[parent or sec] or by_var[sec]
end

function entry_for(sec)
    local v = variant_for(sec)
    return v and v.entry
end

function description(sec)
    return translated(ini_sys:r_string_ex(sec, "description"))
end

-- texture and rectangle of a weapon's inventory icon (HD icon overrides apply)
function icon(sec)
    local tex = utils_xml.get_icons_texture(sec)
    local a = utils_xml.get_item_axis(sec)
    return tex, a
end

-- the names of rounds (ammo or grenades), each once, short names first; GAMMA's worn rounds
-- (_bad, _verybad) share their names with the good ones and are left out
local function round_names(list)
    local out, seen = {}, {}
    for _, r in ipairs(list) do
        if not (r:find("_bad$") or r:find("_verybad$")) then
            local n = translated(ini_sys:r_string_ex(r, "inv_name_short"))
                or translated(ini_sys:r_string_ex(r, "inv_name"))
            if n and not seen[n] then
                seen[n] = true
                out[#out + 1] = n
            end
        end
    end
    return out
end

local function list_of(sec, key)
    local out = {}
    for a in each_of(sec, key) do
        out[#out + 1] = a
    end
    return out
end

-- ammo the weapon chambers, as names (utils_item.get_ammo, as the game reads it)
function ammo_names(sec)
    local ok, list = pcall(utils_item.get_ammo, sec, nil)
    return round_names(ok and list or {})
end

-- whether the inventory shows a stat card: for a suit or helmet, and for a gun with real ammo,
-- not for a knife, whose ammo is fake (utils_ui's tooltip decides the same way, UIInfoItem:GetType)
function has_stat_card(sec)
    if is_armor(sec) then return true end
    return ini_sys:r_string_ex(sec, "ammo_class") ~= nil and not IsItem("fake_ammo_wpn", sec)
end

-- fire modes as the HUD shows them: 1, 3, A
local function modes_text(s)
    local out = {}
    for m in s:gmatch("[^,%s]+") do
        out[#out + 1] = (m == "-1") and "A" or m
    end
    return table.concat(out, " / ")
end

function fire_modes(sec)
    local s = ini_sys:r_string_ex(sec, "fire_modes")
    return s and modes_text(s) or "1"
end

-- What a gun's upgrades open besides its stats (one it ships with is open already): the
-- ammo of each caliber an upgrade converts it to, and fire modes an upgrade gives it
function upgrade_options(sec)
    local out = { calibres = {}, fire_modes = {} }
    for _, g in ipairs(upgrade_tree(sec)) do
        for _, u in ipairs(g) do
            if not u.installed then
                if calibre(u) then
                    local names = round_names(list_of(u.ps, "ammo_class"))
                    if #names > 0 then out.calibres[#out.calibres + 1] = names end
                end
                local fm = ini_sys:r_string_ex(u.ps, "fire_modes")
                if fm then out.fire_modes[#out.fire_modes + 1] = modes_text(fm) end
            end
        end
    end
    return out
end

function weight(sec)
    return ini_sys:r_float_ex(sec, "inv_weight") or 0
end

-- a weight as the inventory shows it (utils_ui's tooltip: round_100, then the number as is):
-- 0.995 shows as 0.99, 3.30 as 3.3
function kg(x)
    return math.floor(x * 100 + 0.5) / 100
end

---------------------------------------------------------------------------------------------
-- Section-only stand-ins for stat-card functions that need a live weapon. Each returns what
-- Momopate's function would for a weapon of that section as it ships (the card multiplies by
-- the row's magnitude). Formulas from momopate_weaponstats.script.
---------------------------------------------------------------------------------------------

function standin_bspeed(obj, sec)
    return bspeed(params(sec))
end

function standin_range(obj, sec)
    return normalize(ini_sys:r_float_ex(sec, "fire_distance") or 0, 0, 1000)
end

function standin_drag(obj, sec)
    local ammo = first_ammo(sec)
    return ammo and -(ini_sys:r_float_ex(ammo, "k_air_resistance") or 1) or 0
end

function standin_reliability(obj, sec)
    return 1.0 - params(sec).condition_shot_dec - 0.99
end

function standin_recoil(obj, sec)
    return recoil(params(sec))
end

---------------------------------------------------------------------------------------------
-- What fits a gun, and what it is made of
---------------------------------------------------------------------------------------------

-- an item with a name: { sec, name }
local function item_of(sec)
    if not (sec and ini_sys:section_exist(sec)) then return nil end
    local name = translated(ini_sys:r_string_ex(sec, "inv_name"))
    return name and { sec = sec, name = name } or nil
end

-- the names of the grenades a launcher fires
local function grenade_names(sec)
    return round_names(list_of(sec, "grenade_class"))
end

-- What a gun takes. GAMMA lists scopes, laser modules and kits alike in "scopes"; the section
-- the game makes of the gun with one attached tells them apart: a kit makes another gun (a
-- variant in this catalog, or another name; named in `makes`), a laser module turns on a
-- laser the gun lacks (laser_status; a gun with its own laser passes it to every
-- combination), a scope does neither. Also the suppressors and grenade launchers it takes (a
-- launcher with the grenades it fires in `ammo`), those an upgrade mounts (`upgrade`), and
-- which of scope, suppressor, launcher and laser it has built in.
function attachments(sec)
    local out = { scopes = {}, lasers = {}, kits = {}, suppressors = {}, launchers = {}, builtin = {} }
    local own, seen = translated(ini_sys:r_string_ex(sec, "inv_name")), {}
    local own_laser = ini_sys:r_string_ex(sec, "laser_status") == "true"
    local function scope(s)
        if not s or seen[s] then return end
        seen[s] = true
        local it = item_of(s)
        if not it then return end
        local combo = sec .. "_" .. s
        if ini_sys:section_exist(combo) then
            local v = variant_of(combo)
            local cname = translated(ini_sys:r_string_ex(combo, "inv_name"))
            if v or (cname and cname ~= own) then
                -- a kit whose gun plays as this one (the same variant) changes only its looks
                if not (v and v == variant_of(sec)) then
                    it.makes = v and v.name or cname
                end
                table.insert(out.kits, it)
                return
            end
            if not own_laser and ini_sys:r_string_ex(combo, "laser_status") == "true" then
                table.insert(out.lasers, it)
                return
            end
        end
        table.insert(out.scopes, it)
    end
    for s in each_of(sec, "scopes") do
        scope(s)
    end
    local ss = ini_sys:r_string_ex(sec, "scopes_sect")
    if ss and ini_sys:section_exist(ss) then
        scope(ini_sys:r_string_ex(ss, "scope_name"))
    end
    local st = status(sec, "scope_status")
    if st == 2 then
        scope(ini_sys:r_string_ex(sec, "scope_name"))
    end
    out.builtin.scope = st == 1
    local sil = status(sec, "silencer_status")
    local it = sil == 2 and item_of(ini_sys:r_string_ex(sec, "silencer_name"))
    if it then
        table.insert(out.suppressors, it)
    end
    out.builtin.suppressor = sil == 1
    local gl = status(sec, "grenade_launcher_status")
    it = gl == 2 and item_of(ini_sys:r_string_ex(sec, "grenade_launcher_name"))
    if it then
        it.ammo = grenade_names(sec)
        table.insert(out.launchers, it)
    end
    out.builtin.launcher = gl == 1
    out.builtin.laser = own_laser
    -- mounts an upgrade adds (GAMMA's suppressor and underbarrel launcher upgrades set
    -- silencer_status or grenade_launcher_status to 2); one the gun ships with is there already
    local have = {}
    for _, x in ipairs(out.suppressors) do have[x.sec] = true end
    for _, x in ipairs(out.launchers) do have[x.sec] = true end
    for _, g in ipairs(upgrade_tree(sec)) do
        for _, u in ipairs(g) do
            if status(u.ps, "silencer_status") == 2 then
                local s = item_of(ini_sys:r_string_ex(u.ps, "silencer_name"))
                if s and not have[s.sec] then
                    have[s.sec] = true
                    s.upgrade = not u.installed
                    table.insert(out.suppressors, s)
                end
            end
            if status(u.ps, "grenade_launcher_status") == 2 then
                local l = item_of(ini_sys:r_string_ex(u.ps, "grenade_launcher_name"))
                if l and not have[l.sec] then
                    have[l.sec] = true
                    l.upgrade = not u.installed
                    l.ammo = grenade_names(ini_sys:r_string_ex(u.ps, "grenade_class") and u.ps or sec)
                    table.insert(out.launchers, l)
                end
            end
        end
    end
    return out
end

-- The magazines a gun takes when Mags Redux runs (GAMMA ships it switched off, and guns then
-- load loose rounds): those of the gun's magazine group (magazine_binder's base_type, from
-- the gun's first ammo), each { sec, name, rounds }, fewest rounds first. None when Mags
-- Redux does not run or the gun takes no magazine.
function mags(sec)
    local out = {}
    if not magazine_binder then return out end
    local ok, bt = pcall(magazine_binder.get_weapon_base_type, sec)
    if not (ok and bt) then return out end
    local okl, list = pcall(magazine_binder.get_mags_for_basetype, bt)
    for _, m in ipairs(okl and type(list) == "table" and list or {}) do
        local it = item_of(m)
        if it then
            it.rounds = ini_sys:r_float_ex(m, "max_mag_size") or 0
            out[#out + 1] = it
        end
    end
    table.sort(out, function(a, b)
        if a.rounds ~= b.rounds then return a.rounds < b.rounds end
        return a.name < b.name
    end)
    return out
end

-- Nimble's trade-ins (Darkasleif's Nimble Upgrades Guns): he gives a gun for one of several
-- others plus money. His script keeps them in its dialog functions (NimbleTrade.script), so
-- they are listed here; the prices are his own variables, read while his script runs. His
-- Groza offer has no dialog option and is left out.
local COLTS = { "wpn_colt1911", "wpn_colt1911_alt", "wpn_colt1911_duty", "wpn_colt1911_merc",
    "wpn_colt1911_modern", "wpn_colt1911_n", "wpn_colt1911_new", "wpn_colt1911_kimber" }
NIMBLE = {
    { gives = "wpn_colt1911_camo", takes = COLTS, cost = "CoonanCost" },
    { gives = "wpn_colt1911_custom", takes = COLTS, cost = "StrayerVoigtCost" },
    { gives = "wpn_desert_eagle_nimble", takes = { "wpn_desert_eagle", "wpn_desert_eagle_custom", "wpn_desert_eagle_modern" },
      cost = "DeagleCost" },
    { gives = "wpn_usp_nimble", takes = { "wpn_usp", "wpn_usp_custom", "wpn_usp_match" }, cost = "USPCost" },
    { gives = "wpn_protecta_nimble", takes = { "wpn_protecta", "wpn_protecta_aim", "wpn_protecta_camo", "wpn_protecta_custom" },
      cost = "ProtectaCost" },
    { gives = "wpn_spas12_nimble", takes = { "wpn_spas12", "wpn_spas12_custom" }, cost = "SPAS12Cost" },
    { gives = "wpn_toz34_mark4_23", takes = { "wpn_toz34", "wpn_toz34_custom", "wpn_toz34_decor", "wpn_toz34_mark4" },
      cost = "TOZ34Cost" },
    { gives = "wpn_mp5_nimble", takes = { "wpn_mp5", "wpn_mp5_alt", "wpn_mp5_custom" }, cost = "MP5Cost" },
    { gives = "wpn_g36nimble_rwap", takes = { "wpn_g36", "wpn_g36_camo", "wpn_g36k", "wpn_g36ka4_rwap", "wpn_g36v_rwap" },
      cost = "G36Cost" },
    { gives = "wpn_pkm_zenit_siber", takes = { "wpn_pkm_siber" }, cost = "PKMCost" },
    { gives = "wpn_dvl10_m1", takes = { "wpn_dvl10" }, cost = "UrbanaCost" },
    { gives = "wpn_dvl10", takes = { "wpn_dvl10_m1" }, cost = "SaboteurCost" },
    { gives = "wpn_svu_nimble", takes = { "wpn_svu", "wpn_svu_alt" }, cost = "SVUCost" },
}

-- a listed section's name as the catalog shows it: its variant's, else its own
local function shown_name(sec)
    local v = variant_of(sec)
    return v and v.name or translated(ini_sys:r_string_ex(sec, "inv_name"))
end

-- Nimble's trade-ins that concern a section, while his script runs: `gets` (what he gives for
-- it: { name, cost }) and `from` (what he takes for it: { names = the guns, any one; cost }).
-- Guns this mod list does not have are left out.
function nimble(sec)
    local out = { gets = {}, from = {} }
    if not NimbleTrade then return out end
    -- a section counts as the gun it plays as (its variant), so a merged copy counts too
    local mine = variant_of(sec)
    local function is_mine(s)
        return s == sec or (mine ~= nil and variant_of(s) == mine)
    end
    for _, t in ipairs(NIMBLE) do
        local cost = tonumber(NimbleTrade[t.cost])
        if cost and ini_sys:section_exist(t.gives) then
            local takes_it = false
            for _, s in ipairs(t.takes) do
                if is_mine(s) then takes_it = true end
            end
            local name = shown_name(t.gives)
            if takes_it and name then
                out.gets[#out.gets + 1] = { name = name, cost = cost }
            end
            if is_mine(t.gives) then
                local names, seen = {}, {}
                for _, s in ipairs(t.takes) do
                    local n = ini_sys:section_exist(s) and shown_name(s)
                    if n and not seen[n] then
                        seen[n] = true
                        names[#names + 1] = n
                    end
                end
                if #names > 0 then out.from[#out.from + 1] = { names = names, cost = cost } end
            end
        end
    end
    return out
end

---------------------------------------------------------------------------------------------
-- Where a gun turns up: on the Zone's fighters, in stashes, from a kit, in a new-game kit.
-- Each is read from the mod that does it, as that mod reads it; a mod list without one of
-- them leaves that part out. Built on first use, once a game.
---------------------------------------------------------------------------------------------

-- ranks, lowest first (creatures\game_relations.ltx), and the factions whose fighters the
-- Zone spawns and a new game starts in
RANKS = { "novice", "trainee", "experienced", "professional", "veteran", "expert", "master", "legend" }
FACTIONS = { "stalker", "dolg", "freedom", "csky", "ecolog", "killer", "army", "bandit", "monolith",
    "zombied", "renegade", "greh", "isg" }
local RANK_AT, FACTION_AT = {}, {}
for i, r in ipairs(RANKS) do RANK_AT[r] = i end
for i, f in ipairs(FACTIONS) do FACTION_AT[f] = i end

-- the fields of a value split on a separator, trimmed: "a, b" -> { "a", "b" }
local function fields(s, sep)
    local out = {}
    for x in ((s or "") .. sep):gmatch("(.-)" .. sep) do
        out[#out + 1] = x:match("^%s*(.-)%s*$")
    end
    return out
end

-- the lines of an ini section as key, value pairs (none when the section is missing)
local function lines(ini, sec)
    local out = {}
    if not ini:section_exist(sec) then return out end
    for i = 0, (ini:line_count(sec) or 0) - 1 do
        local _, k, v = ini:r_line_ex(sec, i, "", "")
        if k then out[#out + 1] = { k = k, v = v } end
    end
    return out
end

-- a local of another script, through a function of that script that uses it. Mods wrap such
-- functions ("local f = tm.fn; function tm.fn(...) return f(...) end"; Descriptive Stash
-- Coordinates wraps set_random_stash), so the functions a function holds are looked in too,
-- nearest first, up to WRAPS deep.
local WRAPS = 3

local function upvalue(fn, name)
    if not (debug and debug.getupvalue) then return nil end
    local level = { fn }
    for _ = 0, WRAPS do
        local held = {}
        for _, f in ipairs(level) do
            for i = 1, type(f) == "function" and 255 or 0 do
                local n, v = debug.getupvalue(f, i)
                if n == nil then break end
                if n == name then return v end
                if type(v) == "function" then held[#held + 1] = v end
            end
        end
        level = held
    end
end

-- NPC loadouts (npc_loadouts.ltx and what it includes, as xrs_rnd_npc_loadout gives them out).
-- A slot is lines of "section:addons:ammo:weight:...", one picked by weight (10 when left out);
-- a section the game lacks is skipped. A fighter's loadout is his faction-and-rank one, else
-- his faction's, else the default; snipers and special forces with a loadout of their own
-- (loadouts_per_name) count under their faction and rank, or as "special" when their spawn
-- section names no rank (UNISG's black ops).
local carried     -- gun model -> faction -> rank (or "special") -> the chance one fighter carries it
-- A line's second field asks for attachments: bits 1 scope (one of the gun's scopes, or its
-- scope mount), 2 launcher, 4 suppressor, rolled against the loadout's chances; "r" any the
-- gun can take (xrs_rnd_npc_loadout.resolve_random_attachment)
local npc_attach  -- gun section -> the attachment bits some loadout line asks for

local function slot_chances(ini, slot)
    local weights, total = {}, 0
    for _, l in ipairs(lines(ini, slot)) do
        local f = fields(l.k, ":")
        if f[1] ~= "" and ini_sys:section_exist(f[1]) then
            local w = tonumber(f[4]) or 10
            weights[f[1]] = (weights[f[1]] or 0) + w
            total = total + w
            if w > 0 then
                local bits = (f[2] == "r") and 7 or tonumber(f[2]) or 0
                npc_attach[f[1]] = bit.bor(npc_attach[f[1]] or 0, bits)
            end
        end
    end
    local out = {}
    for sec, w in pairs(weights) do
        local e = entry_for(sec)
        if e then out[e] = (out[e] or 0) + w / total end
    end
    return out
end

local function build_carried()
    carried, npc_attach = {}, {}
    local ok, ini = pcall(ini_file, "items\\settings\\npc_loadouts\\npc_loadouts.ltx")
    if not (ok and ini and ini:section_exist("default")) then return end
    local slots = {}
    local function add(loadout, faction, rank)
        local sum = {}
        for _, k in ipairs({ "primary", "secondary", "extra" }) do
            local slot = ini:r_string_ex(loadout, k)
            if slot and ini:section_exist(slot) then
                slots[slot] = slots[slot] or slot_chances(ini, slot)
                for e, c in pairs(slots[slot]) do
                    sum[e] = (sum[e] or 0) + c
                end
            end
        end
        for e, c in pairs(sum) do
            carried[e] = carried[e] or {}
            local by = carried[e][faction] or {}
            carried[e][faction] = by
            by[rank] = math.max(by[rank] or 0, c)
        end
    end
    for _, f in ipairs(FACTIONS) do
        for _, r in ipairs(RANKS) do
            local l = f .. "_" .. r
            if not ini:section_exist(l) then
                l = ini:section_exist(f) and f or "default"
            end
            add(l, f, r)
        end
    end
    for _, l in ipairs(lines(ini, "loadouts_per_name")) do
        local f = ini_sys:r_string_ex(l.k, "community")
        local r = ini_sys:r_string_ex(l.k, "spec_rank")
        if l.v and ini:section_exist(l.v) and FACTION_AT[f] then
            add(l.v, f, RANK_AT[r] and r or "special")
        end
    end
end

-- faction -> rank (or "special") -> chance, as rows, the likeliest first:
--     { { faction, ranks = { rank, ... } lowest first, special = true when a special squad
--     without a rank does }, ... }
local function faction_rows(t)
    local out = {}
    for f, by in pairs(t or {}) do
        local ranks, best = {}, by.special or 0
        for _, r in ipairs(RANKS) do
            if (by[r] or 0) > 0 then
                ranks[#ranks + 1] = r
                best = math.max(best, by[r])
            end
        end
        local special = (by.special or 0) > 0
        if #ranks > 0 or special then
            out[#out + 1] = { faction = f, ranks = ranks, special = special or nil, best = best }
        end
    end
    table.sort(out, function(a, b)
        if a.best ~= b.best then return a.best > b.best end
        return FACTION_AT[a.faction] < FACTION_AT[b.faction]
    end)
    return out
end

-- The factions whose fighters carry a gun model, the likeliest first (faction_rows)
function carriers(sec)
    local e = entry_for(sec)
    if not e then return {} end
    if not carried then build_carried() end
    return faction_rows(carried[e])
end

-- Who wears a suit or helmet. A fighter's suit and helmet drop by his visual (death_manager's
-- [outfit_by_visual] in items\settings\death_generic.ltx, read through itms_manager as
-- death_manager reads it); which fighters wear which visual is plugins\arsenal_census.ltx,
-- which tools/census.py writes from the NPC character files (a script cannot read them). A
-- spawn section's faction is its community.
local worn     -- armor model -> faction -> rank (or "special") -> the share of its fighters in it

-- "rank:count, ..." -> { rank = count }
local function rank_counts(v)
    local out = {}
    for _, x in ipairs(fields(v, ",")) do
        local r, n = x:match("^(%w+)%s*:%s*(%d+)$")
        if r then out[r] = tonumber(n) end
    end
    return out
end

local function build_worn()
    worn = {}
    local death = itms_manager and itms_manager.ini_death
    local ok, census = pcall(ini_file, "plugins\\arsenal_census.ltx")
    if not (death and ok and census) then return end
    -- a faction's characters per rank, all its spawn sections together, and those in each item
    -- (every visual that drops it): the share is the chance one of its fighters of that rank
    -- wears it, a story character or a small special squad weighing as little as it spawns
    local total, wearing = {}, {}
    census:section_for_each(function(sec)
        local f = ini_sys:r_string_ex(sec, "community")
        if not (f and FACTION_AT[f]) then return end
        total[f] = total[f] or {}
        for r, n in pairs(rank_counts(census:r_string_ex(sec, "characters"))) do
            total[f][r] = (total[f][r] or 0) + n
        end
        for _, l in ipairs(lines(census, sec)) do
            local drop = l.k ~= "characters" and death:r_string_ex("outfit_by_visual", l.k)
            local seen = {}
            for _, item in ipairs(drop and fields(drop, ",") or {}) do
                local e = item ~= "" and ini_sys:section_exist(item) and entry_for(item)
                if e and not seen[e] then
                    seen[e] = true
                    wearing[e] = wearing[e] or {}
                    wearing[e][f] = wearing[e][f] or {}
                    for r, n in pairs(rank_counts(l.v)) do
                        wearing[e][f][r] = (wearing[e][f][r] or 0) + n
                    end
                end
            end
        end
    end)
    for e, by_f in pairs(wearing) do
        worn[e] = {}
        for f, per in pairs(by_f) do
            worn[e][f] = {}
            for r, n in pairs(per) do
                worn[e][f][r] = n / total[f][r]
            end
        end
    end
end

-- The factions whose fighters wear a suit or helmet, the likeliest first (faction_rows)
function worn_by(sec)
    local e = entry_for(sec)
    if not e then return {} end
    if not worn then build_worn() end
    return faction_rows(worn[e])
end

-- the rank a rating reaches (game_relations' "rating": name, upper bound, name, ...)
function rank_at(value)
    local r = fields(ini_sys:r_string_ex("game_relations", "rating"), ",")
    for i = 1, #r, 2 do
        local top = tonumber(r[i + 1])
        if not top or value < top then return r[i] end
    end
    return r[#r - (#r % 2 == 0 and 1 or 0)]
end

-- How a fighter's suit or helmet drops, as GAMMA decides when his body is first searched
-- (death_manager.validate_drop, wrapped by outfit_drop_mcm): its chance by repair type (MCM),
-- a rare suit's own roll, and, with progressive drops, the player's rank it needs (cost below
-- the outfit_drop_settings line in death_outfits.ltx: rank times its multiplier plus its start;
-- GAMMA's helmet multiplier never applies, its check reads kind as a number):
--     { chance = percent, rank = the rating it needs, or nil }, or { off = true } when this
-- economy drops none
local HALF = { helm_spartan = true }

function armor_drop(sec)
    local ok, mode = pcall(function() return game_difficulties.get_eco_factor("outfit_drops") end)
    mode = ok and tonumber(mode) or 2
    if mode ~= 2 and mode ~= 3 then return { off = true } end
    local rt = ini_sys:r_string_ex(sec, "repair_type") or ""
    rt = (rt == "outfit_novice" and "outfit_light") or (rt == "outfit" and "outfit_medium") or rt
    local okc, c = pcall(function() return outfit_drop_mcm.get_config(rt .. "_chance") end)
    local chance = okc and tonumber(c) or 50
    local rare = death_manager and death_manager.rare_armors
    if type(rare) == "table" and rare[sec] then chance = chance * 0.15 end
    if HALF[sec] then chance = chance * 0.5 end
    if mode == 3 then return { chance = chance } end
    local cost = ini_sys:r_float_ex(sec, "cost")
    if not cost then return { off = true } end
    local death = itms_manager and itms_manager.ini_death
    local start = death and death:r_float_ex("outfit_drop_settings", "cost_start") or 25000
    local multi = death and death:r_float_ex("outfit_drop_settings", "rank_multiplier") or 20
    local need = (cost - start) / multi
    return { chance = chance, rank = need > 0 and math.ceil(need) or nil }
end

-- Grok's and Darkasleif's Armor Exchange: a faction's traders swap any one of a set of suits,
-- plus money, for another suit, to members of that faction. Its dialogs (one a faction) run
-- its tables, which hold the price, the suit given and the suits taken (grok_armor_convert's
-- globals, read while its script runs); who offers each dialog is the census's
-- [arsenal_dialogs]. Its renegade tables have no dialog and are left out.
EXCHANGE = {
    { dialog = "armor_exchange_insider_military", faction = "army",
      tables = { "army_medium", "army_skat", "army_exolight", "army_exo", "army_noso" } },
    { dialog = "armor_exchange_insider_cs", faction = "csky",
      tables = { "cs_light", "cs_medium", "cs_sci", "cs_skat", "cs_exolight", "cs_exo" } },
    { dialog = "armor_exchange_insider_duty", faction = "dolg",
      tables = { "dolg_medium", "dolg_sci", "dolg_skat", "dolg_exolight", "dolg_exo", "dolg_noso" } },
    { dialog = "armor_exchange_insider_bandit", faction = "bandit",
      tables = { "bandit_light", "bandit_medium", "bandit_sci", "bandit_skat", "bandit_exolight", "bandit_exo" } },
    { dialog = "armor_exchange_insider_mercenary", faction = "killer",
      tables = { "merc_light", "merc_medium", "merc_sci", "merc_skat", "merc_exolight", "merc_exo", "merc_noso" } },
    { dialog = "armor_exchange_insider_loner", faction = "stalker",
      tables = { "loner_light", "loner_medium", "loner_sci", "loner_exolight", "loner_exo" } },
    { dialog = "armor_exchange_insider_freedom", faction = "freedom",
      tables = { "freedom_medium", "freedom_sci", "freedom_skat", "freedom_exolight", "freedom_exo", "freedom_noso" } },
    { dialog = "armor_exchange_insider_monolith", faction = "monolith",
      tables = { "mono_medium", "mono_sci", "mono_skat", "mono_exolight", "mono_exo", "mono_noso" } },
    { dialog = "armor_exchange_insider_sin", faction = "greh", tables = { "greh_medium", "greh_exo" } },
    { dialog = "armor_exchange_insider_ecolog", faction = "ecolog", tables = { "ecolog_medium", "ecolog_sci", "ecolog_exo" } },
    { dialog = "armor_exchange_insider_isg", faction = "isg",
      tables = { "isg_medium", "isg_sci", "isg_skat", "isg_exolight", "isg_exo", "isg_noso" } },
}

-- the census file (tools/census.py), or nil
local function census()
    local ok, ini = pcall(ini_file, "plugins\\arsenal_census.ltx")
    return ok and ini or nil
end

-- the names of the characters that offer a dialog, as the census lists them
local function givers(dialog)
    local c = census()
    local out = {}
    for _, n in ipairs(fields(c and c:r_string_ex("arsenal_dialogs", dialog), ",")) do
        local t = n ~= "" and translated(n)
        if t then out[#out + 1] = t end
    end
    return out
end

-- The exchanges that concern a suit model: `gets` (what a trader takes for it: { traders,
-- faction, cost, count = how many suits, any one }) and `takes` (what he gives for it:
-- { traders, faction, cost, name }). None without the mod, or for a dialog nobody offers.
function exchange(sec)
    local out = { gets = {}, takes = {} }
    local e = entry_for(sec)
    local conv = grok_armor_convert
    if not (e and conv) then return out end
    for _, x in ipairs(EXCHANGE) do
        local who = givers(x.dialog)
        for _, name in ipairs(#who > 0 and x.tables or {}) do
            local t = conv[name]
            local cost = type(t) == "table" and tonumber(t.cost)
            local reward = cost and t.reward
            if reward and ini_sys:section_exist(reward) then
                local n, mine = 0, false
                for s, v in pairs(t) do
                    if v == true and ini_sys:section_exist(s) then
                        n = n + 1
                        if entry_for(s) == e then mine = true end
                    end
                end
                if entry_for(reward) == e and n > 0 then
                    out.gets[#out.gets + 1] = { traders = who, faction = x.faction, cost = cost, count = n }
                end
                local rname = shown_name(reward)
                if mine and rname then
                    out.takes[#out.takes + 1] = { traders = who, faction = x.faction, cost = cost, name = rname }
                end
            end
        end
    end
    return out
end

---------------------------------------------------------------------------------------------
-- More ways gear turns up, each read from what does it while the game runs (what a script
-- cannot read is in the census): traders, story characters, tasks and story gifts, corpses'
-- extra loot, crafting. sources() and obtainable() put them together with the rest.
---------------------------------------------------------------------------------------------

-- the sections a condlist names ("{+info} supplies_2, supplies_1"), its conditions and effects
-- dropped
local function condlist_sections(s)
    local out = {}
    for _, part in ipairs(fields(s, ",")) do
        local sec = part:gsub("{.-}", ""):gsub("%%.-%%", ""):match("^%s*([%w_%.%-]+)%s*$")
        if sec then out[#out + 1] = sec end
    end
    return out
end

-- Story gifts: what a story dialog or quest hands over, in scripts that keep it in their
-- function bodies (dialogs_jupiter, dialogs_zaton, dialogs_hidden_threat; Living Legend gives
-- its gauss rifle back for good), so they are listed here, like Nimble's trade-ins
GIFTS = { "wpn_wincheaster1300_trapper", "wpn_abakan", "helm_protective", "wpn_sig550", "wpn_groza", "wpn_fort_snag",
    "helm_hardhat_snag", "wpn_spas12", "helm_tactic", "specops_outfit", "wpn_pkm_zulus", "wpn_gauss_quest" }

-- the communities whose bodies GAMMA's death_manager fills from its item lists, and the ranks
-- of its sections (<community>[_private][_<rank>])
local CORPSE_COMMS = { "stalker", "dolg", "freedom", "bandit", "army", "zombied", "ecolog", "killer", "monolith", "csky",
    "renegade", "greh", "isg", "greh_npc", "army_npc" }

local turns_up     -- item section -> { trader, corpse, task, gift, craft, homestead = true; story = { name, ... } }

local function mark_up(sec, kind, name)
    if not (sec and sec ~= "" and ini_sys:section_exist(sec)) then return end
    turns_up[sec] = turns_up[sec] or {}
    local t = turns_up[sec]
    if kind == "story" then
        t.story = t.story or {}
        if name then t.story[#t.story + 1] = name end
    else
        t[kind] = true
    end
end

local function build_turns_up()
    turns_up = {}
    -- Traders: a config some NPC's logic names (the census's [arsenal_trade]) stocks what its
    -- [trader] buy_supplies sections list with a count and a chance above zero, as trade_manager
    -- and the engine do; its sell_condition sections hide what they list without a value (GAMMA's
    -- presets hide every gun, suit and helmet that way, so traders sell knives and addons)
    local c = census()
    for _, l in ipairs(c and lines(c, "arsenal_trade") or {}) do
        local ok, ini = pcall(ini_file, "items\\trade\\" .. l.k .. ".ltx")
        if ok and ini and ini:section_exist("trader") then
            local hidden
            for _, s in ipairs(condlist_sections(ini:r_string_ex("trader", "sell_condition"))) do
                local d = {}
                for _, x in ipairs(lines(ini, s)) do
                    if x.v == nil or x.v:match("^%s*$") then d[x.k] = true end
                end
                if hidden == nil then
                    hidden = d
                else
                    for k in pairs(hidden) do
                        if not d[k] then hidden[k] = nil end
                    end
                end
            end
            hidden = hidden or {}
            for _, sup in ipairs(condlist_sections(ini:r_string_ex("trader", "buy_supplies"))) do
                for _, x in ipairs(lines(ini, sup)) do
                    local v = fields(x.v, ",")
                    if (tonumber(v[1]) or 0) > 0 and (tonumber(v[2]) or 0) > 0 and not hidden[x.k] then
                        mark_up(x.k, "trader")
                    end
                end
            end
        end
    end
    -- Story characters' gear (the census's [arsenal_supplies]: name strings)
    for _, l in ipairs(c and lines(c, "arsenal_supplies") or {}) do
        for _, n in ipairs(fields(l.v, ",")) do
            mark_up(l.k, "story", n ~= "" and n or nil)
        end
    end
    -- Corpses' extra loot (death_manager): an item of a community's lists with a chance above
    -- zero, which [item_count] lets a body hold at least one of
    local death = itms_manager and itms_manager.ini_death
    if death then
        local most = {}
        for _, x in ipairs(lines(death, "item_count")) do
            local v = fields(x.v, ",")
            most[x.k] = tonumber(v[2] ~= "" and v[2] or v[1]) or 0
        end
        for _, comm in ipairs(CORPSE_COMMS) do
            for _, pv in ipairs({ "", "_private" }) do
                for _, r in ipairs({ "", "_novice", "_trainee", "_experienced", "_professional", "_veteran", "_expert",
                    "_master", "_legend" }) do
                    for _, x in ipairs(lines(death, comm .. pv .. r)) do
                        if (tonumber(fields(x.v, ",")[1]) or 0) > 0 and (most[x.k] or 0) >= 1 then
                            mark_up(x.k, "corpse")
                        end
                    end
                end
            end
        end
    end
    -- Tasks: the items their effects reward (=reward_item, =reward_random_item), and the gun a
    -- task gives its hostile squad (task_loadout_other), from task_manager's configs
    local tasks = task_manager and task_manager.task_ini
    if tasks then
        tasks:section_for_each(function(sec)
            for _, x in ipairs(lines(tasks, sec)) do
                if x.k == "task_loadout_other" then
                    mark_up((x.v or ""):match("^%s*([%w_%.%-]+)"), "task")
                end
                for _, effect in ipairs({ "reward_item%(([^%)]*)%)", "reward_random_item%(([^%)]*)%)" }) do
                    for args in (x.v or ""):gmatch(effect) do
                        for _, a in ipairs(fields(args, ":")) do
                            mark_up(a, "task")
                        end
                    end
                end
            end
        end)
    end
    -- the guns the pump station's guards carry ({ gun, ammo } in tasks_pump_station_defense's
    -- _GUNS_FOR_GUARDS)
    local ps = tasks_pump_station_defense
    local guards = upvalue(ps and ps.spawn_and_set, "_GUNS_FOR_GUARDS")
    for _, g in ipairs(type(guards) == "table" and guards or {}) do
        if type(g) == "table" and type(g[1]) == "string" then mark_up(g[1], "task") end
    end
    -- story gifts
    for _, g in ipairs(GIFTS) do
        mark_up(g, "gift")
    end
    -- Homestead's stash loot when a treasure roll comes up empty (its gamma_yellow_loot: a list
    -- of sections per tier)
    local hs = stalker_camp_builder
    local yl = upvalue(hs and hs.generate_gamma_stash_loot, "gamma_yellow_loot")
    for _, tier in pairs(type(yl) == "table" and yl or {}) do
        for _, s in ipairs(type(tier) == "table" and tier or {}) do
            if type(s) == "string" then mark_up(s, "homestead") end
        end
    end
    -- Crafting: a workshop recipe's result (x_<item> in items\settings\craft.ltx's sections)
    local craft = itms_manager and itms_manager.ini_craft
    if craft then
        craft:section_for_each(function(sec)
            for _, x in ipairs(lines(craft, sec)) do
                local item = x.k:match("^x_(.+)$")
                if item then mark_up(item, "craft") end
            end
        end)
    end
end

-- how an item section turns up besides what the rest of this script reads: { trader, corpse,
-- task, gift, craft, homestead = true; story = { name string, ... } }, or nil
function turns_up_as(sec)
    if not turns_up then build_turns_up() end
    return turns_up[sec]
end

-- Stashes (Grok's stash overhaul, treasure_manager.script). An item in [possible_items] that
-- this game's economy does not bar, with a kind, a tier (grok_items_tier.ltx) and a price,
-- goes into a stash when math.random(1, 100) is below its kind's chance times the tier's
-- multiplier, in common or rare stashes; at 1 or less it never does. Each item's tier is drawn
-- from the stash's level's list (the script's local map_tiers), and marked stashes skip a few
-- levels (its local blacklisted_maps).
STASH_LEVELS = 3
local stashed, stashed_eco     -- gun model -> { [tier] = true }, and the economy it was built for
local stashed_secs             -- the sections stashes hold

local function economy()
    local ok, eco = pcall(function() return game_difficulties.get_eco_factor("type") end)
    return ok and tonumber(eco) or 1
end

local function build_stashed(eco)
    stashed, stashed_eco, stashed_secs = {}, eco, {}
    local tm = treasure_manager
    local ini, tiers = tm and tm.ini_treasure, tm and tm.ini_tiers
    if not (ini and tiers) then return end
    for _, l in ipairs(lines(ini, "possible_items")) do
        local sec = l.k
        local e = ini_sys:section_exist(sec) and entry_for(sec)
        local barred = false
        for _, x in ipairs(fields(l.v, ",")) do
            if tonumber(x) == eco then barred = true end
        end
        local kind, tier = e and ini_sys:r_string_ex(sec, "kind"), e and tiers:r_float_ex(sec, "tier")
        if e and not barred and kind and tier and (ini_sys:r_float_ex(sec, "cost") or 1000) > 1 then
            tier = math.max(1, math.min(5, math.ceil(tier)))
            for _, t in ipairs({ "kind_tier_effect_common", "kind_tier_effect_rare" }) do
                local v = fields(ini:r_string_ex(t, kind), ",")
                local chance, multi = tonumber(v[1]), tonumber(v[tier * 2 + 1])
                if chance and multi and chance * multi > 1 then
                    stashed[e] = stashed[e] or {}
                    stashed[e][tier] = true
                    stashed_secs[sec] = true
                end
            end
        end
    end
end

-- the stash table for this game's economy, built anew when the economy changed
local function stash_ready()
    local eco = economy()
    if not stashed or stashed_eco ~= eco then build_stashed(eco) end
end

-- Whether stashes hold a gun model: nil if they never do, else the levels whose stashes
-- most often draw its tier, best first, at most STASH_LEVELS (none when the level lists
-- cannot be read)
function stashes(sec)
    local e = entry_for(sec)
    if not e then return nil end
    stash_ready()
    local tiers = stashed[e]
    if not tiers then return nil end
    local tm = treasure_manager
    local lists = upvalue(tm and tm.set_random_stash, "map_tiers")
    local skip = upvalue(tm and tm.box_in_valid_map, "blacklisted_maps")
    local best = {}
    for lvl, v in pairs(type(lists) == "table" and lists or {}) do
        local n = 0
        for _, t in ipairs(v) do
            if tiers[t] then n = n + 1 end
        end
        if n > 0 and not (type(skip) == "table" and skip[lvl]) then
            best[#best + 1] = { lvl = lvl, share = n / #v }
        end
    end
    table.sort(best, function(a, b)
        if a.share ~= b.share then return a.share > b.share end
        return a.lvl < b.lvl
    end)
    local out = {}
    for i = 1, math.min(STASH_LEVELS, #best) do
        out[i] = best[i].lvl
    end
    return out
end

-- Guns a kit makes of another gun model: a kit in a gun's scopes whose combination is a gun
-- model of its own in the catalog (one that plays as the gun is in its Accessories already)
local made     -- gun model -> { { from = the gun's name, kit = the kit's name, base = the gun's model, kit_sec }, ... }

local function build_made()
    made = {}
    build()
    local seen = {}
    for _, c in ipairs(CATEGORIES) do
        for _, e in ipairs(by_cat[c]) do
            for _, v in ipairs(e.variants) do
                for _, s in ipairs(v.members) do
                    for k in each_of(s, "scopes") do
                        local m = variant_of(s .. "_" .. k)
                        local kit = m and m.entry ~= e and item_of(k)
                        local key = kit and (m.entry.sec .. "|" .. v.name .. "|" .. kit.name)
                        if key and not seen[key] then
                            seen[key] = true
                            made[m.entry] = made[m.entry] or {}
                            table.insert(made[m.entry], { from = v.name, kit = kit.name, base = e, kit_sec = k })
                        end
                    end
                end
            end
        end
    end
end

function made_from(sec)
    local e = entry_for(sec)
    if not e then return {} end
    if not made then build_made() end
    return made[e] or {}
end

-- New-game kits: each faction's [<faction>_loadout] in new_game_loadouts.ltx, as
-- ui_mm_faction_select reads it (a line is "item = picked, count, points, hardest economy";
-- not picked: given free), and the items new_game_loadout_injector_mcm adds or takes out
ECONOMIES = 3
local kits     -- gun model -> { { faction, points (nil: given), eco = { [n] = true } or nil }, ... }

local function build_kits()
    kits = {}
    local function add(e, faction, points, eco)
        kits[e] = kits[e] or {}
        table.insert(kits[e], { faction = faction, points = points, eco = eco })
    end
    local inj = new_game_loadout_injector_mcm
    local removed = inj and inj.loadout_removed_items or {}
    local ok, ini = pcall(ini_file, "items\\settings\\new_game_loadouts.ltx")
    for _, f in ipairs((ok and ini) and FACTIONS or {}) do
        for _, l in ipairs(lines(ini, f .. "_loadout")) do
            local e = not removed[l.k] and ini_sys:section_exist(l.k) and entry_for(l.k)
            local v = fields(l.v, ",")
            if e and (v[1] == "true" or v[1] == "false") then
                local top, eco = tonumber(v[4]), nil
                if top then
                    eco = {}
                    for n = 1, math.min(top, ECONOMIES) do eco[n] = true end
                end
                add(e, f, v[1] == "true" and (tonumber(v[3]) or 0) or nil, eco)
            end
        end
    end
    for sec, list in pairs(inj and inj.loadout_items or {}) do
        local e = ini_sys:section_exist(sec) and entry_for(sec)
        for _, it in ipairs(e and list or {}) do
            local eco
            if next(it.economy or {}) then
                eco = {}
                for n = 1, ECONOMIES do
                    if it.economy["st_econ_" .. n] then eco[n] = true end
                end
            end
            for _, f in ipairs(FACTIONS) do
                if not next(it.faction or {}) or it.faction[f] then
                    add(e, f, (not it.add_to_inventory) and (tonumber(it.points) or 0) or nil, eco)
                end
            end
        end
    end
end

-- The new-game kits that hold a gun model, one per price and set of economies:
--     { { factions = { faction, ... }, points (nil: given free), economies = { n, ... } (nil: every one) }, ... }
function starting_kits(sec)
    local e = entry_for(sec)
    if not e then return {} end
    if not kits then build_kits() end
    local groups, out = {}, {}
    for _, k in ipairs(kits[e] or {}) do
        local ecos = {}
        for n = 1, ECONOMIES do
            if not k.eco or k.eco[n] then ecos[#ecos + 1] = n end
        end
        local key = tostring(k.points) .. "|" .. table.concat(ecos, ",")
        local g = groups[key]
        if #ecos > 0 and not g then
            g = { factions = {}, points = k.points, economies = (#ecos < ECONOMIES) and ecos or nil, has = {} }
            groups[key] = g
            out[#out + 1] = g
        end
        if g and not g.has[k.faction] then
            g.has[k.faction] = true
            table.insert(g.factions, k.faction)
        end
    end
    for _, g in ipairs(out) do
        table.sort(g.factions, function(a, b) return FACTION_AT[a] < FACTION_AT[b] end)
        g.has = nil
    end
    return out
end

-- The parts a gun is made of (GAMMA's weapon parts: items\settings\parts.ltx, con_parts_list,
-- read through itms_manager as item_parts does), each { sec, name }.
function parts(sec)
    local out = {}
    local ini = itms_manager and itms_manager.ini_parts
    if not ini then return out end
    local key = ini_sys:r_string_ex(sec, "parent_section") or sec
    local list = ini:r_string_ex("con_parts_list", key) or ini:r_string_ex("con_parts_list", sec)
    for p in (list or ""):gmatch("[^,%s]+") do
        local it = item_of(p)
        if it then out[#out + 1] = it end
    end
    return out
end

-- R.I.S.K. (Neffi's Randomized Item Stat Kits) weapon enhancements: upgrade sections its kits
-- install on one gun at a time. A family is a group, risk_up_gr_wpn_<family>, whose elements'
-- change sections add a fixed amount (not a share of the gun's own) and carry a "value", the
-- strength its tooltip shows. Per family, the card value of the gun as it ships with its
-- weakest and strongest good result, and with its worst bad one, through the card formulas
-- here; weight in kg; damage, which R.I.S.K. applies when a shot lands, as its percent. Sway
-- moves the card's handling, as handling does.
RISK_FAMILIES = {
    { family = "accuracy", stat = "accuracy" },
    { family = "handling", stat = "handling" },
    { family = "sway", stat = "handling" },
    { family = "fire_rate", stat = "fire_rate" },
    { family = "velocity", stat = "speed" },
    { family = "reliability", stat = "reliability" },
    { family = "recoil", stat = "recoil" },
    { family = "weight", stat = "weight", lower_better = true },
    { family = "damage", stat = "damage" },
}

-- { { family, stat, base, low, high (the good results), worst (the worst bad one) }, ... } in
-- the card's order; none without R.I.S.K. or for a stat the card formulas cannot compute
function risk_enhancements(sec)
    local out = {}
    if is_armor(sec) then return out end
    local p = params(sec)
    for _, f in ipairs(RISK_FAMILIES) do
        local g = "risk_up_gr_wpn_" .. f.family
        local base
        if f.stat == "weight" then
            base = kg(weight(sec))
        elseif f.stat == "damage" then
            base = 0
        else
            base = CARD[f.stat](p)
        end
        local low, high, worst
        for el in each_of(ini_sys:section_exist(g) and base ~= nil and g or "", "elements") do
            local ps = ini_sys:r_string_ex(el, "section")
            local v = ps and ini_sys:r_float_ex(ps, "value")
            if v and v ~= 0 then
                local x
                if f.stat == "weight" then
                    x = kg(weight(sec) + (ini_sys:r_float_ex(ps, "inv_weight") or 0))
                elseif f.stat == "damage" then
                    x = v
                else
                    local q = {}
                    for k, val in pairs(p) do q[k] = val end
                    for _, k in ipairs(PARAMS) do
                        local d = ini_sys:r_float_ex(ps, k)
                        if d then q[k] = q[k] + d end
                    end
                    x = CARD[f.stat](q)
                end
                if x and v > 0 then
                    low, high = math.min(low or x, x), math.max(high or x, x)
                elseif x then
                    local bad = f.lower_better and math.max or math.min
                    worst = worst and bad(worst, x) or x
                end
            end
        end
        if low then
            out[#out + 1] = { family = f.family, stat = f.stat, base = base, low = low, high = high, worst = worst }
        end
    end
    return out
end

-- The camos a gun model can wear, as 3DSS for GAMMA's camo wheel lists them
-- (z_3dss_gamma_camo_system: its loaded configs, items\settings\camo\*.ltx, and its own checks,
-- read through the upvalues of get_camo_options and assign_drop_camo), each once by name:
--     { name, icon (a texture id), required (it must be discovered first), locked (not
--     discovered in this game), factions = { faction, ... } whose fighters carry the gun and
--     can have it in this camo, likeliest first }
-- None when the camo system does not run or has nothing for the gun.
function camos(sec)
    local out = {}
    local e = entry_for(sec)
    local cs = z_3dss_gamma_camo_system
    local get = cs and cs.get_camo_options
    local files = upvalue(get, "config_files")
    local belongs = upvalue(get, "target_belongs_to_weapon")
    local label_for = upvalue(get, "label_for")
    local unlocked = upvalue(get, "camo_is_unlocked")
    if not (e and type(files) == "table" and belongs and label_for and unlocked) then return out end
    local can_drop = upvalue(cs.assign_drop_camo, "camo_can_drop_for")
    local weight = upvalue(cs.assign_drop_camo, "camo_rarity_weight")
    local carriers_of = {}
    for _, c in ipairs(carriers(sec)) do carriers_of[c.faction] = true end
    local by_name = {}
    for _, v in ipairs(e.variants) do
        for _, s in ipairs(v.members) do
            for _, fd in ipairs(files) do
                for _, t in ipairs(fd.sections and fd.sections[s] and fd.section_order or {}) do
                    local d = fd.sections[t]
                    if d and belongs(fd, s, t) then
                        local name = label_for(fd, s, t)
                        local c = by_name[name]
                        if not c then
                            c = { name = name, icon = d.icon, required = false, locked = true, factions = {}, w = {} }
                            by_name[name] = c
                            out[#out + 1] = c
                        end
                        c.required = c.required or d.unlock_required == true
                        c.locked = c.locked and not unlocked(fd, t)
                        for _, f in ipairs(FACTIONS) do
                            if carriers_of[f] and can_drop and weight and can_drop(d, f) then
                                c.w[f] = math.max(c.w[f] or 0, weight(d, f) or 0)
                            end
                        end
                    end
                end
            end
        end
    end
    for _, c in ipairs(out) do
        for _, f in ipairs(FACTIONS) do
            if (c.w[f] or 0) > 0 then c.factions[#c.factions + 1] = f end
        end
        local w = c.w
        table.sort(c.factions, function(a, b)
            if w[a] ~= w[b] then return w[a] > w[b] end
            return FACTION_AT[a] < FACTION_AT[b]
        end)
        c.w = nil
    end
    return out
end

-- The kits that repair a gun, each { sec, name }: the cleaning and repair kits of its
-- repair_type (Weapon Parts Overhaul's toolkit_map, a local of zzzz_arti_jamming_repairs read
-- through get_suitable_kit), then any repair item whose repair_only names that type (a
-- knife's sharpening stones; _g's item list)
function repair_kits(sec)
    local out, seen = {}, {}
    local rt = ini_sys:r_string_ex(ini_sys:r_string_ex(sec, "parent_section") or sec, "repair_type")
    if not rt then return out end
    local function add(k)
        local it = not seen[k] and item_of(k)
        if it then
            seen[k] = true
            out[#out + 1] = it
        end
    end
    local wpo = zzzz_arti_jamming_repairs
    local map = upvalue(wpo and wpo.get_suitable_kit, "toolkit_map")
    for _, k in ipairs(type(map) == "table" and type(map[rt]) == "table" and map[rt] or {}) do
        add(k)
    end
    local ok, list = pcall(GetItemList, "repair")
    local more = {}
    for k, v in pairs(ok and type(list) == "table" and list or {}) do
        if type(v) == "table" and v[rt] then more[#more + 1] = k end
    end
    table.sort(more)
    for _, k in ipairs(more) do
        add(k)
    end
    return out
end

---------------------------------------------------------------------------------------------
-- Armor: suits and helmets. Their stat card is utils_ui.stats_table.outfit as GAMMA sets it
-- up (Accurate Defense Values' ish_item_stats): grok_actor_damage_balancer's protections and
-- BR class, Outfits Affect Movespeed's speed, the game's own radiation, belt slots and carry
-- weight. GAMMA's functions read a live suit, so stand-ins here read the same values from the
-- section, kept as the engine keeps them (CustomOutfit.cpp, ActorHelmet.cpp): protections and
-- bone armor are float32 and upgrades add to them in float32, or a value lands a point off;
-- the card's burn is light burn, copied from burn when the suit loads, which no upgrade moves.
---------------------------------------------------------------------------------------------

-- a number as a float32: round to nearest, ties to even
function f32(x)
    if x == 0 or x ~= x then return x end
    local m, e = math.frexp(x)
    m = m * 16777216
    local r = math.floor(m + 0.5)
    if r - m == 0.5 and r % 2 == 1 then r = r - 1 end
    return math.ldexp(r / 16777216, e)
end

PROTECTIONS = { "burn_protection", "shock_protection", "chemical_burn_protection", "radiation_protection",
    "telepatic_protection", "wound_protection", "strike_protection", "explosion_protection" }

-- the armor a bones profile gives a bone: the second number of its line ("koeff, armor, ..."),
-- or of the profile's "default" line for a bone it does not list
local function bone_armor(profile, bone)
    if not (profile and ini_sys:section_exist(profile)) then return 0 end
    local s = ini_sys:r_string_ex(profile, bone) or ini_sys:r_string_ex(profile, "default")
    return tonumber(fields(s, ",")[2]) or 0
end

-- an upgrade's changes added to a suit's values, as the engine adds them: bones_koeff_protection_add
-- adds its profile's armor bone by bone
local function add_upgrade(p, ps)
    local add = ini_sys:r_string_ex(ps, "bones_koeff_protection_add")
    if add then
        p.armor = f32(p.armor + f32(bone_armor(add, p.bone)))
    end
    for _, k in ipairs(PROTECTIONS) do
        local d = ini_sys:r_float_ex(ps, k)
        if d then p[k] = f32(p[k] + f32(d)) end
    end
    p.artefact_count = p.artefact_count + (ini_sys:r_float_ex(ps, "artefact_count") or 0)
    p.additional_inventory_weight = p.additional_inventory_weight + (ini_sys:r_float_ex(ps, "additional_inventory_weight") or 0)
end

-- A suit's or helmet's values as the engine keeps them: its own, plus the upgrades it ships
-- with (installed_upgrades). `armor` is the bone armor the card shows for bullets: the spine's,
-- a helmet's head.
function armor_params(sec)
    local p = { sec = sec, bone = is_helmet(sec) and "bip01_head" or "bip01_spine" }
    p.armor = f32(bone_armor(ini_sys:r_string_ex(sec, "bones_koeff_protection"), p.bone))
    for _, k in ipairs(PROTECTIONS) do
        p[k] = f32(ini_sys:r_float_ex(sec, k) or 0)
    end
    p.light_burn = p.burn_protection
    p.artefact_count = ini_sys:r_float_ex(sec, "artefact_count") or 0
    p.additional_inventory_weight = ini_sys:r_float_ex(sec, "additional_inventory_weight") or 0
    for u in each_of(sec, "installed_upgrades") do
        local ps = ini_sys:section_exist(u) and ini_sys:r_string_ex(u, "section")
        if ps and ini_sys:section_exist(ps) then add_upgrade(p, ps) end
    end
    return p
end

-- grok_actor_damage_balancer's adjuster and ini key for a hit type, as its get_adb_constants
-- sets them (it sets them for every card row it fills, the same way)
local function adb(name)
    local g = grok_actor_damage_balancer
    if not (g and g.get_adb_constants) then return nil end
    g.get_adb_constants(name)
    return tonumber(g.adjuster), g.defense
end

-- get_outfit_value for a section, as it returns for a live suit or helmet at full condition:
-- for bullets the bone armor, else the hit type's protection (burn: light burn), times the
-- hit type's adjuster, in percent rounded up
function standin_outfit_value(obj, sec, name)
    local adj, key = adb(name)
    if not adj then return nil end
    local p = armor_params(sec)
    local v
    if name == "FireWound" then
        v = p.armor
    elseif name == "Burn" then
        v = p.light_burn
    else
        v = key and p[key]
    end
    return v and math.ceil(v * adj * 100)
end

-- utils_item.get_outfit_protection, which the card uses for radiation: a live suit's protection
-- of a hit type (GetDefHitTypeProtection: burn here is burn, upgrades in); its section path
-- leaves out the upgrades a suit ships with
local PROTECTION_OF = { Burn = "burn_protection", Shock = "shock_protection", ChemicalBurn = "chemical_burn_protection",
    Radiation = "radiation_protection", Telepatic = "telepatic_protection", Wound = "wound_protection",
    Strike = "strike_protection", Explosion = "explosion_protection" }

function standin_outfit_protection(obj, sec, name, def)
    local k = PROTECTION_OF[name or ""]
    if not k then return def or 0 end
    return armor_params(sec)[k]
end

-- get_outfit_ap_res: the BR class, 1 - the section's hit_fraction_actor (GAMMA reads the
-- section, so upgrades leave it)
function standin_ap_res(obj, sec)
    return 1 - (ini_sys:r_float_ex(sec, "hit_fraction_actor") or 1)
end

-- Outfits Affect Movespeed's get_outfit_speed: the item's line in outfit_speed.ltx [speed], 1
-- for one it does not list
local speeds
function standin_outfit_speed(obj, sec)
    if not speeds then
        speeds = {}
        local ok, ini = pcall(ini_file, "items\\settings\\outfit_speed.ltx")
        for _, l in ipairs((ok and ini) and lines(ini, "speed") or {}) do
            speeds[l.k] = tonumber(l.v)
        end
    end
    return speeds[sec] or 1
end

-- what makes two suits or helmets of one name play differently: the values of their card and
-- their weight
function armor_signature(sec)
    local p = armor_params(sec)
    local t = { string.format("%.6g", p.armor), num(sec, "hit_fraction_actor") }
    for _, k in ipairs(PROTECTIONS) do
        t[#t + 1] = string.format("%.6g", p[k])
    end
    t[#t + 1] = string.format("%.6g", p.artefact_count)
    t[#t + 1] = string.format("%.6g", p.additional_inventory_weight)
    t[#t + 1] = num(sec, "inv_weight")
    t[#t + 1] = string.format("%.6g", standin_outfit_speed(nil, sec))
    return table.concat(t, "|")
end

-- The card's value of an armor row, as the card shows it, from a suit's values: the row's
-- function as the stand-ins compute it, times the row's magnitude, rounded up; nil for a row
-- these formulas do not cover
local ARMOR_VALUE = {
    fire_wound_protection = function(p) local a = adb("FireWound"); return a and math.ceil(p.armor * a * 100) end,
    burn_protection = function(p) local a = adb("Burn"); return a and math.ceil(p.light_burn * a * 100) end,
    shock_protection = function(p) local a = adb("Shock"); return a and math.ceil(p.shock_protection * a * 100) end,
    chemical_burn_protection = function(p)
        local a = adb("ChemicalBurn"); return a and math.ceil(p.chemical_burn_protection * a * 100)
    end,
    telepatic_protection = function(p)
        local a = adb("Telepatic"); return a and math.ceil(p.telepatic_protection * a * 100)
    end,
    wound_protection = function(p) local a = adb("Wound"); return a and math.ceil(p.wound_protection * a * 100) end,
    strike_protection = function(p) local a = adb("Strike"); return a and math.ceil(p.strike_protection * a * 100) end,
    explosion_protection = function(p)
        local a = adb("Explosion"); return a and math.ceil(p.explosion_protection * a * 100)
    end,
    radiation_protection = function(p, gr) return gr and math.ceil(p.radiation_protection * gr.magnitude) end,
    artefact_count = function(p) return math.ceil(p.artefact_count) end,
    additional_inventory_weight = function(p) return math.ceil(p.additional_inventory_weight) end,
}

-- the card's row definition for an armor stat
local function armor_row(stat)
    utils_ui.prepare_stats_table()
    local t = utils_ui.stats_table and utils_ui.stats_table.outfit
    return t and t[stat]
end

-- An upgrade tree's best path for one value: per group, the upgrade whose own change plus the
-- best of the groups it opens adds most, or none; a group the item ships an upgrade in keeps
-- it (its change is in the item's values already) and counts only what it opens. Returns the
-- total and the change sections on the path.
local function best_path(sec, gain)
    local installed = {}
    for u in each_of(sec, "installed_upgrades") do installed[u] = true end
    local busy = {}
    local function group(g)
        if busy[g] or not ini_sys:section_exist(g) then return 0, {} end
        busy[g] = true
        local best, path, fixed = 0, {}, false
        for el in each_of(g, "elements") do
            if installed[el] then fixed = el end
        end
        for el in each_of(g, "elements") do
            if ini_sys:section_exist(el) and (not fixed or el == fixed) then
                local ps = ini_sys:r_string_ex(el, "section")
                local own = (not fixed and ps and ini_sys:section_exist(ps)) and gain(ps) or 0
                local sum, sub = own, {}
                if own ~= 0 then sub[1] = ps end
                for nxt in each_of(el, "effects") do
                    local n, p = group(nxt)
                    sum = sum + n
                    for _, x in ipairs(p) do sub[#sub + 1] = x end
                end
                if sum > best then best, path = sum, sub end
            end
        end
        busy[g] = nil
        return best, path
    end
    local total, out = 0, {}
    for g in each_of(sec, "upgrades") do
        if not g:find(NOT_UPGRADES) then
            local n, p = group(g)
            total = total + n
            for _, x in ipairs(p) do out[#out + 1] = x end
        end
    end
    return total, out
end

-- what one upgrade adds to the value an armor row shows (none to light burn, BR class, speed)
local ARMOR_GAIN = {
    fire_wound_protection = function(ps, bone)
        local add = ini_sys:r_string_ex(ps, "bones_koeff_protection_add")
        return add and bone_armor(add, bone) or 0
    end,
}
for _, k in ipairs(PROTECTIONS) do
    if k ~= "burn_protection" then
        ARMOR_GAIN[k] = function(ps) return ini_sys:r_float_ex(ps, k) or 0 end
    end
end
ARMOR_GAIN.artefact_count = function(ps) return ini_sys:r_float_ex(ps, "artefact_count") or 0 end
ARMOR_GAIN.additional_inventory_weight = function(ps) return ini_sys:r_float_ex(ps, "additional_inventory_weight") or 0 end

-- An armor stat fully upgraded: the item's values with the upgrades of the path that adds most
-- to it, as the engine adds them. Returns the maximum and the value as it is, or nil for a
-- row the formulas here do not cover.
function armor_max(sec, stat)
    local f = ARMOR_VALUE[stat]
    if not f then return nil end
    local gr = armor_row(stat)
    local p = armor_params(sec)
    local base = f(p, gr)
    if base == nil then return nil end
    local gain = ARMOR_GAIN[stat]
    if not gain then return base, base end
    local _, path = best_path(sec, function(ps) return gain(ps, p.bone) end)
    for _, ps in ipairs(path) do
        add_upgrade(p, ps)
    end
    return math.max(base, f(p, gr) or base), base
end

-- The tags that tell suits or helmets of one name apart: their card's values, as "name value",
-- in the card's order, then weight
local function plain(s)
    return (s or ""):gsub("%%c%[[^%]]*%]", ""):match("^%s*(.-)[%s:]*$")
end

local ARMOR_STANDIN = {
    get_outfit_value = "standin_outfit_value",
    get_outfit_protection = "standin_outfit_protection",
    get_outfit_ap_res = "standin_ap_res",
    get_outfit_speed = "standin_outfit_speed",
}

local STANDIN = {
    get_weapon_bspeed = "standin_bspeed",
    get_weapon_range = "standin_range",
    get_weapon_drag = "standin_drag",
    get_weapon_reliability = "standin_reliability",
    get_weapon_recoil = "standin_recoil",
}

-- a card row whose function needs a live item, with a stand-in from the table in its place (the
-- function's own arguments kept); a row that needs none as it is
local function standin_row(gr, standin)
    local f = gr.value_functor
    local alt = f and standin[f[2]]
    if not alt then return gr end
    local g = {}
    for k, v in pairs(gr) do g[k] = v end
    g.value_functor = { "arsenal_data", alt, unpack(f, 3) }
    return g
end

ARMOR_TAGGERS = {}
for _, stat in ipairs({ "fire_wound_protection", "apres_modifier", "burn_protection", "shock_protection",
    "chemical_burn_protection", "radiation_protection", "telepatic_protection", "wound_protection",
    "strike_protection", "explosion_protection", "artefact_count", "additional_inventory_weight", "speed_modifier" }) do
    ARMOR_TAGGERS[#ARMOR_TAGGERS + 1] = function(sec)
        local gr = armor_row(stat)
        if not gr then return nil end
        local s = utils_ui.get_stats_string_value(nil, sec, standin_row(gr, ARMOR_STANDIN), stat)
        s = s and plain(s):gsub("^%+", ""):gsub("%s+%%", "%%") or "0"
        return string.format("%s %s", plain(game.translate_string(gr.name)), s)
    end
end
ARMOR_TAGGERS[#ARMOR_TAGGERS + 1] = function(sec)
    return string.format("%s %s", tostring(kg(weight(sec))), game.translate_string("st_kg"))
end

-- whether a listed section is a suit or helmet
function is_armor(sec)
    local e = get(sec)
    return e ~= nil and ARMOR[e.cat] == true
end

-- The stat card's rows for a section in the card's order: { stat = key, gr = row definition },
-- the weapon card's for a gun, the outfit card's for a suit or helmet. With a live item the
-- card's own functions apply; without one a stand-in replaces any function that needs it.
function stat_rows(live, sec)
    utils_ui.prepare_stats_table()
    local armor = sec and is_armor(sec)
    local standin = armor and ARMOR_STANDIN or STANDIN
    local rows = {}
    for stat, gr in pairs(utils_ui.stats_table and utils_ui.stats_table[armor and "outfit" or "weapon"] or {}) do
        rows[#rows + 1] = { stat = stat, gr = live and gr or standin_row(gr, standin) }
    end
    table.sort(rows, function(a, b) return (a.gr.index or 0) < (b.gr.index or 0) end)
    return rows
end

---------------------------------------------------------------------------------------------
-- Whether an item ever turns up in this game, short of a console command: fighters carry it
-- (or wear it, where bodies drop armor), stashes hold it, a new-game kit has it, or it turns
-- up another way (turns_up_as); or it comes of what does: a trade-in with Nimble for a gun that
-- turns up, a kit that turns up on a gun that does, the Armor Exchange for a suit that does.
-- The Wish Granter's riches wish, which hands out nearly every item at the end of the story,
-- does not count.
---------------------------------------------------------------------------------------------

local addon_ok     -- addon section -> true when it turns up
local rolled       -- a gun section a fighter's gun becomes with a kit fitted -> the gun's section
local reach        -- model -> true when it turns up

-- Addons: what turns up on its own (traders, crafting, story characters), what a new-game kit
-- has, and what fighters' and stashes' guns carry. A loadout line that asks for a scope picks
-- one of the gun's scopes but those npc_loadouts.ltx keeps off NPC guns ([scope_blacklist],
-- [weapon_scope_blacklist]) and fits it when the gun has a combination with it (<gun>_<scope>):
-- a scope comes off again, a kit does not (its combination is a gun of its own, its own parent),
-- so the fighter carries that gun instead. A line that asks for a launcher or suppressor fits
-- its mount's (xrs_rnd_npc_loadout); a stash gun may come with any mount's (treasure_manager).
local function build_addons()
    addon_ok, rolled = {}, {}
    if not turns_up then build_turns_up() end
    for s in pairs(turns_up) do
        addon_ok[s] = true
    end
    local ok, kit_ini = pcall(ini_file, "items\\settings\\new_game_loadouts.ltx")
    for _, f in ipairs((ok and kit_ini) and FACTIONS or {}) do
        for _, l in ipairs(lines(kit_ini, f .. "_loadout")) do
            addon_ok[l.k] = true
        end
    end
    local okn, npc = pcall(ini_file, "items\\settings\\npc_loadouts\\npc_loadouts.ltx")
    local black, per_gun = {}, {}
    if okn and npc then
        for _, x in ipairs(lines(npc, "scope_blacklist")) do
            black[x.k] = true
        end
        for _, x in ipairs(lines(npc, "weapon_scope_blacklist")) do
            per_gun[x.k] = per_gun[x.k] or {}
            for _, s in ipairs(fields(x.v, ",")) do per_gun[x.k][s] = true end
        end
    end
    if not carried then build_carried() end
    stash_ready()
    -- the mounts of a gun section whose attachment bits allow them (1 scope, 2 launcher, 4 suppressor)
    local MOUNTS = { { 1, "scope_status", "scope_name" }, { 2, "grenade_launcher_status", "grenade_launcher_name" },
        { 4, "silencer_status", "silencer_name" } }
    local function mounts(s, bits)
        for _, m in ipairs(MOUNTS) do
            local n = bit.band(bits, m[1]) ~= 0 and status(s, m[2]) == 2 and ini_sys:r_string_ex(s, m[3])
            if n then addon_ok[n] = true end
        end
    end
    for s, bits in pairs(npc_attach) do
        if bit.band(bits, 1) ~= 0 then
            for k in each_of(s, "scopes") do
                local combo = s .. "_" .. k
                if not black[k] and not (per_gun[s] and per_gun[s][k]) and ini_sys:section_exist(combo) then
                    local p = ini_sys:r_string_ex(combo, "parent_section")
                    if p and p ~= combo then
                        addon_ok[k] = true
                    else
                        rolled[combo] = s
                    end
                end
            end
        end
        mounts(s, bits)
    end
    for s in pairs(stashed_secs) do
        mounts(s, 7)
    end
end

-- whether an addon (a scope, suppressor, launcher, laser module or kit) turns up
function addon_turns_up(sec)
    if not addon_ok then build_addons() end
    return addon_ok[sec] == true
end

-- every way a model turns up besides its fighters, stashes and new-game kits:
-- { trader, corpse, task, gift, craft, homestead = true; story = { name string, ... };
-- rolled = { the guns fighters carry it as, with a kit fitted, ... } }
local model_up
function turns_up_model(sec)
    local e = entry_for(sec)
    if not e then return {} end
    if not model_up then
        model_up = {}
        if not addon_ok then build_addons() end
        for combo, base in pairs(rolled) do
            local m, n = entry_for(combo), shown_name(base)
            if m and n then
                model_up[m] = model_up[m] or {}
                model_up[m].rolled = model_up[m].rolled or {}
                table.insert(model_up[m].rolled, n)
            end
        end
        for s, t in pairs(turns_up) do
            local m = entry_for(s)
            if m then
                model_up[m] = model_up[m] or {}
                local u = model_up[m]
                for k, v in pairs(t) do
                    if k == "story" then
                        u.story = u.story or {}
                        for _, n in ipairs(v) do u.story[#u.story + 1] = n end
                    else
                        u[k] = true
                    end
                end
            end
        end
    end
    return model_up[e] or {}
end

local function build_reach()
    reach = {}
    build()
    if not addon_ok then build_addons() end
    for _, c in ipairs(CATEGORIES) do
        for _, e in ipairs(by_cat[c]) do
            local worn_drops = ARMOR[c] and #worn_by(e.sec) > 0 and not (armor_drop(e.sec) or {}).off
            if #carriers(e.sec) > 0 or stashes(e.sec) or #starting_kits(e.sec) > 0 or worn_drops
                or next(turns_up_model(e.sec)) then
                reach[e] = true
            end
        end
    end
    -- what comes of what turns up, until nothing more does
    local conv = grok_armor_convert
    local more = true
    while more do
        more = false
        local function add(e)
            if e and not reach[e] then
                reach[e] = true
                more = true
            end
        end
        for _, t in ipairs(NimbleTrade and NIMBLE or {}) do
            if tonumber(NimbleTrade[t.cost]) and ini_sys:section_exist(t.gives) then
                for _, s in ipairs(t.takes) do
                    local m = ini_sys:section_exist(s) and entry_for(s)
                    if m and reach[m] then add(entry_for(t.gives)) end
                end
            end
        end
        for _, c in ipairs(CATEGORIES) do
            for _, e in ipairs(by_cat[c]) do
                if reach[e] then
                    for _, v in ipairs(e.variants) do
                        for _, s in ipairs(v.members) do
                            for k in each_of(s, "scopes") do
                                local m = addon_ok[k] and variant_of(s .. "_" .. k)
                                if m then add(m.entry) end
                            end
                        end
                    end
                end
            end
        end
        for _, x in ipairs(conv and EXCHANGE or {}) do
            if #givers(x.dialog) > 0 then
                for _, name in ipairs(x.tables) do
                    local t = conv[name]
                    local reward = type(t) == "table" and tonumber(t.cost) and t.reward
                    local r = reward and ini_sys:section_exist(reward) and entry_for(reward)
                    if r and not reach[r] then
                        for s, v in pairs(t) do
                            local m = v == true and ini_sys:section_exist(s) and entry_for(s)
                            if m and reach[m] then
                                add(r)
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end

-- whether a model turns up in this game (any of its sections; a scoped or silenced combination
-- counts as its gun)
function obtainable(sec)
    local e = entry_for(sec)
    if not e then return false end
    if not reach then build_reach() end
    return reach[e] == true
end

-- The models a faction's fighters carry or wear, what turns up only: { { e, ranks = { [rank or
-- "special"] = chance }, armor = true for a suit or helmet }, ... }, the likeliest first
function faction_gear(f)
    build()
    if not carried then build_carried() end
    if not worn then build_worn() end
    local out = {}
    for _, src in ipairs({ { carried, false }, { worn, true } }) do
        for e, by in pairs(src[1]) do
            local r = by[f]
            if r and next(r) and obtainable(e.sec) and not (src[2] and (armor_drop(e.sec) or {}).off) then
                local best = 0
                for _, c in pairs(r) do best = math.max(best, c) end
                out[#out + 1] = { e = e, ranks = r, armor = src[2] or nil, best = best }
            end
        end
    end
    table.sort(out, function(a, b)
        if a.best ~= b.best then return a.best > b.best end
        return a.e.name < b.e.name
    end)
    return out
end

-- the models a faction's new-game kit offers
function kit_models(f)
    if not kits then build_kits() end
    local out = {}
    for e, list in pairs(kits) do
        for _, k in ipairs(list) do
            if k.faction == f then
                out[#out + 1] = e
                break
            end
        end
    end
    return out
end

-- Whether a model is special: it turns up, but no ordinary fighter carries or wears it and no
-- stash holds it (a kit, a trade-in, a special squad, a story character, a task or gift does):
-- a gunsmith's word of mouth
function special(sec)
    local e = entry_for(sec)
    if not (e and obtainable(e.sec)) then return false end
    for _, c in ipairs(carriers(e.sec)) do
        if #c.ranks > 0 then return false end
    end
    for _, c in ipairs(ARMOR[e.cat] and worn_by(e.sec) or {}) do
        if #c.ranks > 0 then return false end
    end
    return stashes(e.sec) == nil
end

-- forget the catalog (a new game, or a test)
function reset()
    by_var, by_cat, total = nil, nil, 0
    trees = {}
    carried, stashed, stashed_eco, made, kits, worn = nil, nil, nil, nil, nil, nil
    speeds, turns_up, addon_ok, rolled, reach, model_up = nil, nil, nil, nil, nil, nil
end
