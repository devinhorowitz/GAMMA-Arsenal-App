--[[
    Arsenal's page in the PDA: the gun models of the running game by category, each with the
    game's own stat card, its variants, and which of them the player has found. Laid out like
    the PDA's Guide: categories, the models of one, and the selected model's entry.

    The entry is built anew for each gun and added to its scroll view only once complete: a
    scroll view measures its content when a window is added, never when one is resized.

    The same page also opens flat, on a key set in MCM (arsenal_mcm): a window of its own in
    the 2D PDA's frame, drawn straight to the screen. With the 3D PDA on, the PDA's pages are
    drawn onto the in-hand screen, which softens them; the flat window is as sharp as the
    inventory. Escape, the key again, or Back closes it.
--]]

local theme = arsenal_theme
local SINGLETON, FLAT
-- the PDA's pages sit this far into the screen (pda_16.xml main); the flat window too, so
-- its frame and page land where the 2D PDA's do
local PDA_X, PDA_Y = 112, 34

local ROW_H = 22
local NAME_H = 20       -- one line of the entry's name
local GAP = 6
-- what fits a gun, as tiles (ui_arsenal.xml tile_*): three to a row across the entry's 344
local TILE_COLS, TILE_W, TILE_GAP, TILE_PAD = 3, 108, 10, 4
local PART_TEXT_DY = 6  -- a part's name beside its icon panel, one line centered on it
local CAMO_PAD = 3      -- a camo's swatch inside its panel
-- a new row's glow: its alpha swings between these over the period (ms)
local GLOW_MIN, GLOW_MAX, GLOW_PERIOD = 40, 110, 2000
-- other apps' buttons on a model's page (add_action), in the bar over the lists, right to left
-- from the first, left of "Found only"
local MAX_ACTIONS, ACTION_STEP = 3, 126
local actions = {}      -- { { id, label, show, run }, ... }, in the order added

---------------------------------------------------------------------------------------------
-- a list row: a name, and for a category a count on the right. A new one glows behind its
-- name (`glow`: the glow's XML) until it is read.
---------------------------------------------------------------------------------------------
class "ArsenalRow" (CUIListBoxItem)

function ArsenalRow:__init(xml, key, text, role, count, glow) super(ROW_H)
    self.key = key
    if glow then
        self.glow = xml:InitStatic(glow, self)
    end
    self.name = xml:InitTextWnd("row_name", self)
    self.name:SetText(text)
    self.name:SetTextColor(theme.argb(role))
    if count then
        self.count = xml:InitTextWnd("row_count", self)
        self.count:SetText(count)
    end
end

---------------------------------------------------------------------------------------------
-- the page
---------------------------------------------------------------------------------------------
class "ArsenalPDA" (CUIScriptWnd)

function ArsenalPDA:__init(flat) super()
    self.flat = flat == true
    local x, y = self.flat and PDA_X or 0, self.flat and PDA_Y or 0
    self:SetWndRect(Frect():set(x, y, x + 1024, y + 768))
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_arsenal.xml")
    self.xml = xml
    -- the inventory's own layout, for stat card rows built here
    self.uxml = CScriptXmlInit()
    self.uxml:ParseFile("utils.xml")

    -- flat: the 2D PDA's frame behind the page, the app's name where the PDA puts its caption
    if self.flat then
        xml:InitStatic("flat_bezel", self)
        xml:InitTextWnd("flat_caption", self)
    end

    self.found_count = xml:InitTextWnd("found_count", self)
    xml:InitTextWnd("found_only_lbl", self)
    self.found_only = xml:InitCheck("found_only", self)
    self:Register(self.found_only, "found_only")
    self:AddCallback("found_only", ui_events.BUTTON_CLICKED, self.OnFoundOnly, self)
    self.btn_back = xml:Init3tButton("btn_back", self)
    self:Register(self.btn_back, "btn_back")
    self:AddCallback("btn_back", ui_events.BUTTON_CLICKED, self.OnBack, self)
    xml:InitStatic("rule_top", self)

    xml:InitTextWnd("by_faction_lbl", self)
    self.by_faction_check = xml:InitCheck("by_faction", self)
    self:Register(self.by_faction_check, "by_faction")
    self:AddCallback("by_faction", ui_events.BUTTON_CLICKED, self.OnByFaction, self)
    self.cat_list = xml:InitListBox("cat_list", self)
    self:Register(self.cat_list, "cat_list")
    self:AddCallback("cat_list", ui_events.LIST_ITEM_SELECT, self.OnCategory, self)
    xml:InitStatic("rule_cat", self)
    self.wpn_list = xml:InitListBox("wpn_list", self)
    self:Register(self.wpn_list, "wpn_list")
    self:AddCallback("wpn_list", ui_events.LIST_ITEM_SELECT, self.OnWeapon, self)
    self:AddCallback("wpn_list", ui_events.LIST_ITEM_CLICKED, self.OnWeaponClicked, self)
    xml:InitStatic("rule_wpn", self)
    self.detail = xml:InitScrollView("detail", self)

    -- other apps' buttons for the model shown (add_action), hidden until one applies
    self.action_btns = {}
    for i = 1, MAX_ACTIONS do
        local b = xml:Init3tButton("action_btn", self)
        local p = b:GetWndPos()
        b:SetWndPos(vector2():set(p.x - (i - 1) * ACTION_STEP, p.y))
        b:Show(false)
        self:Register(b, "action_" .. i)
        self:AddCallback("action_" .. i, ui_events.BUTTON_CLICKED, function() self:OnAction(i) end, self)
        self.action_btns[i] = b
    end

    self.cat = arsenal_data.CATEGORIES[1]
    self.sec = nil
end

function ArsenalPDA:__finalize()
    if self.flat then
        FLAT = nil
    else
        SINGLETON = nil
    end
end

---------------------------------------------------------------------------------------------
-- what the player knows (arsenal_intel): with the jailbreak, or without the module, everything
---------------------------------------------------------------------------------------------
local function immersive()
    return arsenal_intel ~= nil and not arsenal_intel.jailbroken()
end

local function listed(e)
    return not arsenal_intel or arsenal_intel.listed(e)
end

local function studied(e)
    return not arsenal_intel or arsenal_intel.studied(e)
end

local function is_new(e)
    return arsenal_intel ~= nil and arsenal_intel.is_new(e)
end

-- the left list's keys: a category ("rifles"), or with the toggle a faction's gear (FACTION ..
-- "dolg"). Which it shows, and the row chosen last in each, last while the game runs, the PDA's
-- page and the flat window alike.
local FACTION = "f:"
local by_faction = false
local last_key = {}

-- the models a row of the left list stands for: a category's, by name; a faction's gear, the
-- guns its fighters carry and the suits and helmets they wear, in the categories' order
local function models_of(key)
    local f = key and key:sub(1, #FACTION) == FACTION and key:sub(#FACTION + 1)
    if not f then return arsenal_data.list(key) end
    local order = {}
    for i, c in ipairs(arsenal_data.CATEGORIES) do order[c] = i end
    local out = {}
    for _, g in ipairs(arsenal_data.faction_gear(f)) do out[#out + 1] = g.e end
    table.sort(out, function(a, b)
        if a.cat ~= b.cat then return (order[a.cat] or 99) < (order[b.cat] or 99) end
        if a.name ~= b.name then return a.name < b.name end
        return a.sec < b.sec
    end)
    return out
end

-- whether something listed under a row of the left list is new
local function fresh_in(key)
    for _, e in ipairs(models_of(key)) do
        if listed(e) and is_new(e) then return true end
    end
    return false
end

-- every time the page is opened: what is found and known may have changed
function ArsenalPDA:Reset()
    self:SetCounts()
    self:FillCategories()
    self:FillWeapons()
end

-- the line over the lists. Counts go over what turns up in this game only; what is new
-- is counted while there is any.
function ArsenalPDA:SetCounts()
    local total, found, known = 0, 0, 0
    for _, c in ipairs(arsenal_data.CATEGORIES) do
        for _, e in ipairs(arsenal_data.list(c)) do
            if arsenal_data.obtainable(e.sec) then
                total = total + 1
                if arsenal_collection.entry_found(e) then found = found + 1 end
                if listed(e) then known = known + 1 end
            end
        end
    end
    if immersive() then
        local new = arsenal_intel.count_new()
        self.found_count:SetText(new > 0
            and string.format(game.translate_string("st_arsenal_known_new_count"), known, found, total, new)
            or string.format(game.translate_string("st_arsenal_known_count"), known, found, total))
    else
        self.found_count:SetText(string.format(game.translate_string("st_arsenal_found_count"), found, total))
    end
end

-- new rows glow in the headings' amber, slowly brightening and fading
function ArsenalPDA:Update()
    CUIScriptWnd.Update(self)
    local wave = 0.5 + 0.5 * math.sin(time_global() * 2 * math.pi / GLOW_PERIOD)
    local color = theme.argb("heading", math.floor(GLOW_MIN + (GLOW_MAX - GLOW_MIN) * wave))
    for _, rows in ipairs({ self.cat_rows or {}, self.wpn_rows or {} }) do
        for _, row in pairs(rows) do
            if row.glow then row.glow:SetTextureColor(color) end
        end
    end
end

function ArsenalPDA:OnBack()
    if self.flat then
        self:Close()
        return
    end
    local pda = ActorMenu.get_pda_menu()
    if pda then
        pda:SetActiveSubdialog("eptLauncher")
    end
end

function ArsenalPDA:Close()
    if self:IsShown() then
        self:HideDialog()
    end
end

-- flat: Escape or the MCM key closes the window; the PDA handles its own keys
function ArsenalPDA:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if self.flat and not res and action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE or dik == arsenal_mcm.flat_key() then
            self:Close()
            return true
        end
    end
    return res
end

function ArsenalPDA:OnFoundOnly()
    self:FillWeapons()
end

-- the categories with something that turns up (with the jailbreak, anything), or with the
-- toggle every faction with gear; each row with how many of what turns up are found, glowing
-- while something listed under it is new
function ArsenalPDA:FillCategories()
    self.cat_list:RemoveAll()
    self.cat_rows, self.cat_index = {}, {}
    self.by_faction_check:SetCheck(by_faction)
    local first
    local function add(key, name, list)
        local n, f = 0, 0
        for _, e in ipairs(list) do
            if arsenal_data.obtainable(e.sec) then
                n = n + 1
                if arsenal_collection.entry_found(e) then f = f + 1 end
            end
        end
        if n > 0 or (#list > 0 and not immersive()) then
            local fresh = fresh_in(key)
            local row = ArsenalRow(self.xml, key, name, fresh and "bright" or "body", string.format("%d/%d", f, n),
                fresh and "cat_glow" or nil)
            self.cat_list:AddExistingItem(row)
            self.cat_rows[key] = row
            self.cat_index[key] = self.cat_list:GetSize() - 1
            first = first or key
        end
    end
    if by_faction then
        for _, f in ipairs(arsenal_data.FACTIONS) do
            add(FACTION .. f, game.translate_string("st_faction_" .. f), models_of(FACTION .. f))
        end
    else
        for _, c in ipairs(arsenal_data.CATEGORIES) do
            add(c, game.translate_string("st_arsenal_cat_" .. c), arsenal_data.list(c))
        end
    end
    if not self.cat_index[self.cat] then
        self.cat = first or ((not by_faction) and arsenal_data.CATEGORIES[1]) or nil
        self.sec = nil
    end
    self.cat_list:SetSelectedIndex(self.cat_index[self.cat] or 0)
end

function ArsenalPDA:OnCategory()
    local item = self.cat_list:GetSelectedItem()
    if item and item.key ~= self.cat then
        self.cat = item.key
        self.sec = nil
        self:FillWeapons()
    end
end

-- the toggle: categories or factions, each view back on the row chosen last in it
function ArsenalPDA:OnByFaction()
    last_key[by_faction] = self.cat
    by_faction = self.by_faction_check:GetCheck() == true
    self.cat = last_key[by_faction]
    self.sec = nil
    self:FillCategories()
    self:FillWeapons()
end

-- a listed model's name color: found, not found, or never turning up (listed only with the
-- jailbreak); a new one is brighter until it is read
local function role_of(e, new)
    if not arsenal_data.obtainable(e.sec) then return "never" end
    if new then return "bright" end
    return arsenal_collection.entry_found(e) and "body" or "dim"
end

-- the models of the chosen category or faction the player knows of (with the jailbreak, all); a
-- model is found once any of its variants is; a new one glows until it is clicked
function ArsenalPDA:FillWeapons()
    self.wpn_list:RemoveAll()
    self.wpn_rows = {}
    local only = self.found_only:GetCheck()
    local keep, first
    for _, e in ipairs(models_of(self.cat)) do
        local found = arsenal_collection.entry_found(e) ~= nil
        if listed(e) and (found or not only) then
            local new = is_new(e)
            local row = ArsenalRow(self.xml, e.sec, e.name, role_of(e, new), nil, new and "wpn_glow" or nil)
            self.wpn_list:AddExistingItem(row)
            self.wpn_rows[e.sec] = row
            local idx = self.wpn_list:GetSize() - 1
            if e.sec == self.sec then keep = idx end
            first = first or e.sec
        end
    end
    if keep then
        self.wpn_list:SetSelectedIndex(keep)
        self:ShowEntry(self.sec)
    elseif first then
        self.wpn_list:SetSelectedIndex(0)
        self:ShowEntry(first)
    else
        self:ShowEntry(nil)
    end
end

function ArsenalPDA:OnWeapon()
    local item = self.wpn_list:GetSelectedItem()
    if item and item.key ~= self.sec then
        self:ShowEntry(item.key)
    end
end

-- a click on a model, the one shown already too: it is read, like an opened letter. A model
-- the list shows first by itself stays new until it is clicked.
function ArsenalPDA:OnWeaponClicked()
    local item = self.wpn_list:GetSelectedItem()
    local e = item and arsenal_data.get(item.key)
    if not (e and arsenal_intel and is_new(e)) then return end
    arsenal_intel.viewed(e)
    if item.glow then
        item.glow:Show(false)
        item.glow = nil
    end
    item.name:SetTextColor(theme.argb(role_of(e, false)))
    -- its category and its factions stop glowing once nothing new is left under them
    for key, row in pairs(self.cat_rows or {}) do
        if row.glow and not fresh_in(key) then
            row.glow:Show(false)
            row.glow = nil
            row.name:SetTextColor(theme.argb("body"))
        end
    end
    self:SetCounts()
end

---------------------------------------------------------------------------------------------
-- the entry
---------------------------------------------------------------------------------------------
local function date_place(at)
    local where = at.lvl and game.translate_string(at.lvl) or ""
    return string.format("%02d.%02d.%04d", at.d or 0, at.mo or 0, at.y or 0), where
end

-- the strings of a list, trimmed, each once, in order
local function distinct(list)
    local out, seen = {}, {}
    for _, s in ipairs(list) do
        s = s and tostring(s):match("^%s*(.-)%s*$")
        if s and s ~= "" and not seen[s] then
            seen[s] = true
            out[#out + 1] = s
        end
    end
    return out
end

-- values of one stat, as one text: "200 RPM", "350 RPM" -> "200 / 350 RPM", by number;
-- values whose units differ are listed whole
function joined(values)
    local nums, unit, same = {}, nil, true
    for _, s in ipairs(values) do
        local n, u = s:match("^(%S+)%s*(.-)$")
        if unit == nil then
            unit = u
        elseif u ~= unit then
            same = false
        end
        nums[#nums + 1] = n
    end
    if not same then
        return table.concat(values, " / ")
    end
    table.sort(nums, function(a, b) return (tonumber(a) or 0) < (tonumber(b) or 0) end)
    return table.concat(nums, " / ") .. ((unit and unit ~= "") and (" " .. unit) or "")
end

-- the card's rows whose fully upgraded value arsenal_data knows (its CARD formulas)
local MAXED = { accuracy = true, handling = true, fire_rate = true, ammo_mag_size = true,
    speed = true, reliability = true, recoil = true }

-- "max 92 %": a stat of a gun model fully upgraded (its best variant's), in the card's unit;
-- nil when no upgrade raises it. A variant counts only where arsenal_data's formula gives the
-- value the card shows (`card`: section -> the card's value text), so a mod that changes the
-- card's formulas leaves the max out instead of making it up; the first such disagreement for
-- a section and stat goes to the log.
local warned = {}
local function max_text(e, row, card)
    if row.gr.track or not (MAXED[row.stat] or arsenal_data.ARMOR[e.cat]) then return nil end
    local best, base
    for _, v in ipairs(e.variants) do
        local ok, m, b = pcall(arsenal_data.max_stat, v.sec, row.stat)
        local shown = card[v.sec] and tonumber(card[v.sec]:match("[-+]?%d+%.?%d*"))
        if ok and m and b and shown then
            if shown == b then
                best = math.max(best or m, m)
                base = math.max(base or b, b)
            elseif not warned[v.sec .. "|" .. row.stat] then
                warned[v.sec .. "|" .. row.stat] = true
                printf("Arsenal: %s %s: the card shows %s, the formula gives %s; no max shown",
                    v.sec, row.stat, tostring(shown), tostring(b))
            end
        end
    end
    if not best or best <= base then return nil end
    local unit = (row.gr.unit and row.gr.unit ~= "") and game.translate_string(row.gr.unit) or ""
    return string.format(game.translate_string("st_arsenal_max"),
        unit ~= "" and (best .. " " .. unit) or tostring(best))
end

-- One row of the stat card for a gun model. Where its variants agree, the card's own row
-- (utils_ui.get_stats_xml); where they differ, the same row from the same layout
-- (utils.xml item_info:stats_box) with each value: "Fire Rate: 200 / 245 / 350 RPM". Right of
-- the value, the most an upgrade tree makes of it.
function ArsenalPDA:StatRow(entry, e, shown, row)
    local order = { shown }
    for _, v in ipairs(e.variants) do
        if v ~= shown then order[#order + 1] = v end
    end
    local values, neg, with, card = {}, false, nil, {}
    if not row.gr.track then
        for _, v in ipairs(order) do
            local ok, s, n = pcall(utils_ui.get_stats_string_value, nil, v.sec, row.gr, row.stat)
            if ok and type(s) == "string" then
                values[#values + 1] = s
                card[v.sec] = s
                neg = neg or n
                with = with or v.sec
            end
        end
        values = distinct(values)
    end
    local st
    if #values < 2 then
        local ok, r = pcall(utils_ui.get_stats_xml, entry, nil, with or shown.sec, row.gr, row.stat)
        st = ok and r or nil
    else
        local ux = self.uxml
        st = ux:InitStatic("item_info:stats_box", entry)
        ux:InitStatic("item_info:stats_box:icon", st):InitTexture(row.gr.icon_p)
        ux:InitTextWnd("item_info:stats_box:cap", st):SetText(game.translate_string(row.gr.name))
        local txt = ux:InitTextWnd("item_info:stats_box:prog_txt", st)
        txt:SetText(joined(values))
        -- the card's colors for a value (utils_ui's clr_list p1, n1)
        txt:SetTextColor(neg and GetARGB(255, 200, 50, 50) or GetARGB(255, 170, 170, 170))
        st:SetAutoDelete(true)
    end
    local mx = st and max_text(e, row, card)
    if mx then
        self.xml:InitTextWnd("entry_max", st):SetText(mx)
    end
    return st
end

-- ranks as one text, lowest first: ranks next to each other as a range ("Rookie – Professional"),
-- all of them as "every rank", a special squad last
local function ranks_text(ranks, special)
    local at, parts = {}, {}
    for i, r in ipairs(arsenal_data.RANKS) do at[r] = i end
    if #ranks == #arsenal_data.RANKS then
        parts[1] = game.translate_string("st_arsenal_all_ranks")
    else
        local i = 1
        while i <= #ranks do
            local j = i
            while j < #ranks and at[ranks[j + 1]] == at[ranks[j]] + 1 do j = j + 1 end
            local low = game.translate_string("st_rank_" .. ranks[i])
            parts[#parts + 1] = (j > i) and string.format(game.translate_string("st_arsenal_rank_range"), low,
                game.translate_string("st_rank_" .. ranks[j])) or low
            i = j + 1
        end
    end
    if special then parts[#parts + 1] = game.translate_string("st_arsenal_special") end
    return table.concat(parts, ", ")
end

-- factions by name, "every faction" for all of them
local function factions_text(list)
    if #list == #arsenal_data.FACTIONS then return game.translate_string("st_arsenal_every_faction") end
    local out = {}
    for _, f in ipairs(list) do out[#out + 1] = game.translate_string("st_faction_" .. f) end
    return table.concat(out, ", ")
end

-- a call into arsenal_data that leaves its part of the page out instead of failing it
local function safe(fn, ...)
    local ok, r = pcall(fn, ...)
    return ok and r or nil
end

-- a share as a percentage: one decimal below 10%, none from there, "<0.1%" for a sliver
local function percent(x)
    local p = (x or 0) * 100
    if p == 0 then return "0%" end
    if p < 0.1 then return "<0.1%" end
    return (p < 10 and string.format("%.1f", p) or tostring(math.floor(p + 0.5))) .. "%"
end

-- a multiplier: "x1.14"
local function times(x)
    return string.format(game.translate_string("st_arsenal_times"), string.format("%.4g", x))
end

-- "a, b or c"
local function or_list(parts)
    if #parts < 2 then return parts[1] or "" end
    return table.concat(parts, ", ", 1, #parts - 1) .. " " .. game.translate_string("st_arsenal_or") .. " " .. parts[#parts]
end

-- what unlocks a trader's tier, in words (arsenal_data.sold_by's need). Heavy Pockets by
-- Arsenal's own string: the game titles its achievements in capitals.
local function need_text(n)
    local T = game.translate_string
    local parts = {}
    if n.goodwill then parts[#parts + 1] = string.format(T("st_arsenal_need_goodwill"), tostring(n.goodwill)) end
    if n.kits then
        parts[#parts + 1] = (n.kits == 1) and T("st_arsenal_need_kit") or string.format(T("st_arsenal_need_kits"), tostring(n.kits))
    end
    if n.drugkit then parts[#parts + 1] = T("st_arsenal_need_drugkit") end
    if n.story then parts[#parts + 1] = T("st_arsenal_need_story") end
    if n.heavy then parts[#parts + 1] = T("st_arsenal_need_heavy") end
    return or_list(parts)
end

-- a gun's jam chance in words (arsenal_data.jam_chance), nil when there is no telling
local function jam_text(j)
    if not j then return nil end
    local T = game.translate_string
    local base = j.base or 0
    if j.worn then
        if base > 0 then return string.format(T("st_arsenal_jam_both"), percent(base), percent(base + j.worn)) end
        return string.format(T("st_arsenal_jam_worn"), percent(j.worn))
    end
    return base > 0 and string.format(T("st_arsenal_jam_base"), percent(base)) or T("st_arsenal_jam_none")
end

-- the columns of a gun's rounds: damage, AP, speed, damage left at 100 m (round_cell's x)
local ROUND_COLS = { 144, 194, 244, 294 }

-- an item's inventory icon in a frame, inset by pad, at most at its own size, centered
local function put_icon(xml, parent, frame, sec, pad)
    local tex, a = arsenal_data.icon(sec)
    if not (tex and a and a.w > 0 and a.h > 0) then return nil end
    pad = pad or 0
    local icon = xml:InitStatic("entry_icon", parent)
    local wide = utils_xml.is_widescreen() and 0.8 or 1
    local fw, fh = frame:GetWidth() - 2 * pad, frame:GetHeight() - 2 * pad
    local k = math.min(fw / (a.w * wide), fh / a.h, 1)
    local w, h = a.w * wide * k, a.h * k
    icon:InitTexture(tex)
    icon:SetTextureRect(Frect():set(a.x1, a.y1, a.x1 + a.w, a.y1 + a.h))
    icon:SetStretchTexture(true)
    icon:SetWndSize(vector2():set(w, h))
    local p = frame:GetWndPos()
    icon:SetWndPos(vector2():set(p.x + pad + (fw - w) / 2, p.y + pad + (fh - h) / 2))
    icon:SetTextureColor(GetARGB(255, 255, 255, 255))
    return icon
end

-- A gun model's page. Its variants (sections of its name that differ in play) share it: the
-- stat card lists each value where they differ, and a list of the variants shows which were
-- found. The icon and description are the first found variant's, else the first variant's.
-- the buttons other apps added (add_action) that apply to the section shown; with none, none
-- shows, and an app that is not installed adds none
function ArsenalPDA:UpdateActions(sec)
    self.action_list, self.action_sec = {}, sec
    for _, a in ipairs(sec and actions or {}) do
        if not a.show or safe(a.show, sec) then
            self.action_list[#self.action_list + 1] = a
        end
    end
    for i, b in ipairs(self.action_btns or {}) do
        local a = self.action_list[i]
        b:Show(a ~= nil)
        if a then
            b:TextControl():SetText(game.translate_string(a.label or a.id))
        end
    end
end

function ArsenalPDA:OnAction(i)
    local a = self.action_list and self.action_list[i]
    if not a then return end
    local ok, err = pcall(a.run, self.action_sec)
    if not ok then
        printf("[arsenal] the %s button failed: %s", a.id, tostring(err))
    end
end

function ArsenalPDA:ShowEntry(sec)
    self.sec = sec
    self.detail:Clear()
    self:UpdateActions(nil)
    if not sec then return end
    local xml = self.xml
    local e = arsenal_data.get(sec)
    if not e then return end
    -- what the player knows of it (arsenal_intel): its stats and what fits it once studied;
    -- where to find it as far as he has learned, or all of it with the jailbreak or once a
    -- technician has told him
    local know, imm = studied(e), immersive()
    local fx = imm and arsenal_intel.facts(e) or {}
    local full = not imm or (fx.ways and fx.ways.gunsmith) or false
    local shown = e.variants[1]
    for _, v in ipairs(e.variants) do
        if arsenal_collection.is_found(v.sec) then
            shown = v
            break
        end
    end
    self:UpdateActions(shown.sec)
    local entry = xml:InitStatic("entry", nil)

    -- the icon on a lighter panel, like the inventory's grid, at most at its own size: the
    -- PDA is drawn onto the in-hand screen, which already softens everything in it, so the
    -- icon is never enlarged on top of that
    xml:InitStatic("entry_icon_bg", entry)
    put_icon(xml, entry, xml:InitStatic("entry_icon_frame", entry), shown.sec)

    -- the name may wrap; the found line goes below it
    local name = xml:InitTextWnd("entry_name", entry)
    name:SetText(e.name)
    name:AdjustHeightToText()
    local line = xml:InitTextWnd("entry_found", entry)
    line:SetWndPos(vector2():set(0, name:GetWndPos().y + math.max(name:GetHeight(), NAME_H)))
    local at = arsenal_collection.entry_found(e)
    local learned = imm and not at and arsenal_intel.learned(e)
    if at then
        local d, where = date_place(at)
        line:SetText(string.format(game.translate_string("st_arsenal_found_on"), d, where))
        line:SetTextColor(theme.argb("good"))
    elseif learned and learned.at then
        line:SetText(string.format(game.translate_string("st_arsenal_learned_on"), (date_place(learned.at)),
            arsenal_intel.describe(learned.how)))
    else
        line:SetText(game.translate_string("st_arsenal_not_found"))
    end
    line:AdjustHeightToText()
    local y = line:GetWndPos().y + line:GetHeight() + GAP

    local function rule()
        local r = xml:InitStatic("entry_rule", entry)
        r:SetWndPos(vector2():set(0, y))
        y = y + 1 + GAP
    end
    local function text(id, s, role)
        local t = xml:InitTextWnd(id, entry)
        t:SetWndPos(vector2():set(0, y))
        t:SetText(s)
        if role then t:SetTextColor(theme.argb(role)) end
        if id == "entry_line" then t:AdjustHeightToText() end
        y = y + t:GetHeight() + 2
        return t
    end
    local function each(fn)
        local out = {}
        for _, v in ipairs(e.variants) do
            out[#out + 1] = fn(v.sec)
        end
        return distinct(out)
    end
    -- what the variants' upgrades open besides stats: other calibers, more fire modes
    local up_calibres, up_modes = {}, {}
    for _, v in ipairs(e.variants) do
        local ok, o = pcall(arsenal_data.upgrade_options, v.sec)
        if ok and o then
            for _, names in ipairs(o.calibres) do
                up_calibres[#up_calibres + 1] = table.concat(names, ", ")
            end
            for _, fm in ipairs(o.fire_modes) do
                up_modes[#up_modes + 1] = fm
            end
        end
    end
    up_calibres, up_modes = distinct(up_calibres), distinct(up_modes)

    -- the game's own stat card, row by row, where the inventory shows one (a knife has none);
    -- a suit or helmet has the outfit card and no fire modes
    local armor = arsenal_data.ARMOR[e.cat] == true
    rule()
    if not know then
        text("entry_line", game.translate_string("st_arsenal_not_studied"), "dim")
    end
    if know and arsenal_data.has_stat_card(shown.sec) then
        for _, row in ipairs(arsenal_data.stat_rows(false, shown.sec)) do
            local st = self:StatRow(entry, e, shown, row)
            if st then
                st:SetWndPos(vector2():set(0, y))
                y = y + st:GetHeight() + 2
            end
        end
        y = y + GAP
    end
    if know and not armor and arsenal_data.has_stat_card(shown.sec) then
        local modes = each(arsenal_data.fire_modes)
        local line_modes = game.translate_string("st_arsenal_fire_modes") .. ": " .. table.concat(modes, "; ")
        local has = {}
        for _, m in ipairs(modes) do has[m] = true end
        local extra = {}
        for _, m in ipairs(up_modes) do
            if not has[m] then extra[#extra + 1] = m end
        end
        if #extra > 0 then
            line_modes = string.format(game.translate_string("st_arsenal_modes_by_upgrade"), line_modes,
                table.concat(extra, "; "))
        end
        text("entry_line", line_modes)
        -- hit power, and how often it jams: the shown variant's
        local hp = safe(arsenal_data.hit_power, shown.sec)
        if hp and hp > 0 then
            text("entry_line", string.format(game.translate_string("st_arsenal_hit_power"), string.format("%.3g", hp)))
        end
        local jam = jam_text(safe(arsenal_data.jam_chance, shown.sec))
        if jam then text("entry_line", jam) end
    end
    -- a round's weight is per box, which the inventory shows; the page leaves it out
    if know and e.cat ~= "ammo" then
        text("entry_line", string.format("%s: %s %s", game.translate_string("st_prop_weight"),
            joined(each(function(s) return tostring(arsenal_data.kg(arsenal_data.weight(s))) end)),
            game.translate_string("st_kg")))
    end

    -- a round: what it does (its own values; a gun's are in that gun's table), and the guns
    -- that fire it, those the player knows
    if know and e.cat == "ammo" then
        local rs = safe(arsenal_data.round_stats, shown.sec)
        local function row(id, s)
            local n = xml:InitTextWnd("round_stat", entry)
            n:SetWndPos(vector2():set(0, y))
            n:SetText(game.translate_string(id))
            n:AdjustHeightToText()
            local v = xml:InitTextWnd("round_value", entry)
            v:SetWndPos(vector2():set(v:GetWndPos().x, y))
            v:SetText(s)
            v:AdjustHeightToText()
            y = y + math.max(n:GetHeight(), v:GetHeight()) + 2
        end
        if rs then
            row("st_arsenal_round_damage", times(rs.damage))
            row("st_arsenal_round_ap", tostring(rs.ap))
            if rs.speed then row("st_arsenal_round_speed", times(rs.speed)) end
            if rs.pellets then row("st_arsenal_round_pellets", tostring(rs.pellets)) end
            if rs.kept and rs.kept[100] then
                row("st_arsenal_round_kept", string.format("%s / %s / %s", percent(rs.kept[50]), percent(rs.kept[100]),
                    percent(rs.kept[200])))
            end
        end
        local guns = {}
        for _, g in ipairs(safe(arsenal_data.fired_by, shown.sec) or {}) do
            if listed(g) then guns[#guns + 1] = g.name end
        end
        if #guns > 0 then
            y = y + GAP
            text("entry_heading", game.translate_string("st_arsenal_fired_by"))
            rule()
            text("entry_line", table.concat(guns, ", "))
        end
    end

    -- a suit or helmet against bullets: the rounds it stops, and what a hit does either way
    if know and armor then
        local p = safe(arsenal_data.penetration, shown.sec)
        if p and p.of > 0 then
            local T = game.translate_string
            y = y + GAP
            text("entry_heading", T("st_arsenal_vs_bullets"))
            rule()
            local s
            if p.holds and p.fails then
                s = string.format(T("st_arsenal_pen_range"), p.holds.name, tostring(p.holds.ap), p.fails.name,
                    tostring(p.fails.ap))
            elseif p.holds then
                s = string.format(T("st_arsenal_pen_all"), p.holds.name, tostring(p.holds.ap))
            else
                s = string.format(T("st_arsenal_pen_none"), p.fails.name, tostring(p.fails.ap))
            end
            text("entry_line", s)
            text("entry_line", string.format(T("st_arsenal_pen_count"), tostring(p.stops), tostring(p.of)))
            text("entry_line", string.format(T("st_arsenal_pen_damage"), percent(p.stopped), percent(p.pierced)), "dim")
        end
    end

    -- R.I.S.K. enhancements, when it runs: per family, the stat with one enhancement on the
    -- shown variant as it ships, weakest to strongest, the worst bad roll after; a card stat
    -- only where the card formulas here give the card's own value, as for the max
    local risk = know and safe(arsenal_data.risk_enhancements, shown.sec) or {}
    local risk_rows = {}
    if #risk > 0 then
        local card_rows = {}
        for _, row in ipairs(arsenal_data.has_stat_card(shown.sec) and arsenal_data.stat_rows(false, shown.sec) or {}) do
            card_rows[row.stat] = row
        end
        for _, r in ipairs(risk) do
            local row, unit, agrees = card_rows[r.stat], "", false
            if row then
                local ok, s = pcall(utils_ui.get_stats_string_value, nil, shown.sec, row.gr, row.stat)
                agrees = ok and type(s) == "string" and tonumber(s:match("[-+]?%d+%.?%d*")) == r.base
                unit = (row.gr.unit and row.gr.unit ~= "") and game.translate_string(row.gr.unit) or ""
            elseif r.stat == "weight" then
                agrees, unit = true, game.translate_string("st_kg")
            elseif r.stat == "damage" then
                agrees, unit = true, "%"
            end
            if agrees then risk_rows[#risk_rows + 1] = { r = r, unit = unit } end
        end
    end
    if #risk_rows > 0 then
        y = y + GAP
        text("entry_heading", game.translate_string("st_arsenal_risk"))
        rule()
        text("entry_line", game.translate_string("st_arsenal_risk_note"), "dim")
        for _, rr in ipairs(risk_rows) do
            local r, u = rr.r, rr.unit ~= "" and (" " .. rr.unit) or ""
            local signed = r.stat == "damage"
            local function num(x) return (signed and x > 0) and ("+" .. x) or tostring(x) end
            local s
            if r.low == r.base and r.high == r.base then
                s = game.translate_string("st_arsenal_risk_same")
            else
                s = ((r.low == r.high) and num(r.low)
                    or string.format(game.translate_string("st_arsenal_rank_range"), num(r.low), num(r.high))) .. u
            end
            if r.worst and r.worst ~= r.base then
                s = string.format(game.translate_string("st_arsenal_risk_bad"), s, num(r.worst) .. u)
            end
            local n = xml:InitTextWnd("risk_name", entry)
            n:SetWndPos(vector2():set(n:GetWndPos().x, y))
            n:SetText(game.translate_string("st_arsenal_risk_" .. r.family))
            n:AdjustHeightToText()
            local v = xml:InitTextWnd("risk_values", entry)
            v:SetWndPos(vector2():set(v:GetWndPos().x, y))
            v:SetText(s)
            v:AdjustHeightToText()
            y = y + math.max(n:GetHeight(), v:GetHeight()) + 2
        end
    end

    -- the variants, each with when and where it was found
    if know and #e.variants > 1 then
        y = y + GAP
        text("entry_heading", game.translate_string("st_arsenal_variants"))
        rule()
        for _, v in ipairs(e.variants) do
            local vat = arsenal_collection.found_at(v.sec)
            if vat then
                local d, where = date_place(vat)
                text("entry_line", string.format(game.translate_string("st_arsenal_variant_found"),
                    v.name, d, where), "good")
            else
                text("entry_line", v.name, "dim")
            end
        end
    end

    -- where to find it: the factions whose fighters carry or wear it (a row each, with their
    -- ranks, the likeliest first; a suit's drop chance after), stashes, traders, story
    -- characters, fighters' kit rolls, bodies' loot, tasks, story gifts, crafting, Homestead, the
    -- Armor Exchange, Nimble's trade-ins, a kit that makes it of another gun, new-game kits. With
    -- the jailbreak, or once a technician has told the player of it, all of it; else only what he
    -- has learned: the factions and ranks he has seen carry it, the stashes and traders he has
    -- seen it at, his own faction's new-game kit
    y = y + GAP
    text("entry_heading", game.translate_string("st_arsenal_where"))
    rule()
    local any = false
    local function line(s, role)
        text("entry_line", s, role)
        any = true
    end
    if not arsenal_data.obtainable(e.sec) then
        line(game.translate_string("st_arsenal_never"), "warn")
    end
    -- a row per faction: its name, and the ranks of its fighters that carry (or wear) it
    local function faction_rows(rows)
        for _, c in ipairs(rows) do
            local f = xml:InitTextWnd("where_faction", entry)
            f:SetWndPos(vector2():set(f:GetWndPos().x, y))
            f:SetText(game.translate_string("st_faction_" .. c.faction))
            f:AdjustHeightToText()
            local r = xml:InitTextWnd("where_ranks", entry)
            r:SetWndPos(vector2():set(r:GetWndPos().x, y))
            r:SetText(ranks_text(c.ranks, c.special))
            r:AdjustHeightToText()
            y = y + math.max(f:GetHeight(), r:GetHeight()) + 2
        end
    end
    -- the rows the player knows of: a faction's, with the ranks he has seen carry it
    local function known_rows(rows, seen)
        if full then return rows end
        local out = {}
        for _, c in ipairs(rows) do
            local by = seen and seen[c.faction]
            if by then
                local ranks = {}
                for _, r in ipairs(c.ranks) do
                    if by[r] then ranks[#ranks + 1] = r end
                end
                local special = (c.special and by.special) or nil
                if #ranks > 0 or special then
                    out[#out + 1] = { faction = c.faction, ranks = ranks, special = special }
                end
            end
        end
        return out
    end
    local carriers = known_rows((not armor) and safe(arsenal_data.carriers, shown.sec) or {}, fx.carried)
    local worn = known_rows(armor and safe(arsenal_data.worn_by, shown.sec) or {}, fx.worn)
    if #carriers > 0 then
        line(game.translate_string("st_arsenal_carried_by"), "dim")
        faction_rows(carriers)
    end
    -- a suit or helmet: who wears it, then how it drops (GAMMA's chance, and the player's
    -- rank it needs with progressive drops)
    if #worn > 0 then
        line(game.translate_string("st_arsenal_worn_by"), "dim")
        faction_rows(worn)
        local d = safe(arsenal_data.armor_drop, shown.sec)
        if d and d.off then
            text("entry_line", game.translate_string("st_arsenal_drop_off"), "dim")
        elseif d and d.chance then
            local pct = (d.chance == math.floor(d.chance)) and string.format("%d%%", d.chance)
                or string.format("%.1f%%", d.chance)
            local rank = d.rank and safe(arsenal_data.rank_at, d.rank)
            text("entry_line", rank and string.format(game.translate_string("st_arsenal_drop_rank"), pct,
                tostring(d.rank), game.translate_string("st_rank_" .. rank))
                or string.format(game.translate_string("st_arsenal_drop_chance"), pct), "dim")
        end
    end
    -- stashes: the levels where one stash most likely holds it, with the chance (a rare stash's
    -- too); else those the player has seen it at
    local odds = full and safe(arsenal_data.stash_odds, shown.sec)
    if odds then
        local T = game.translate_string
        local spots = {}
        for _, r in ipairs(odds) do
            spots[#spots + 1] = (r.rare > 0 and r.rare ~= r.common)
                and string.format(T("st_arsenal_stash_odds_rare"), T(r.lvl), percent(r.common), percent(r.rare))
                or string.format(T("st_arsenal_stash_odds"), T(r.lvl), percent(r.common))
        end
        if #spots > 0 then
            line(string.format(T("st_arsenal_stashes_odds"), table.concat(spots, ", ")))
            text("entry_line", T("st_arsenal_stash_odds_note"), "dim")
        else
            line(T("st_arsenal_stashes"))
        end
    elseif fx.stash then
        local names = {}
        for l in pairs(fx.stash) do names[#names + 1] = game.translate_string(l) end
        table.sort(names)
        line(string.format(game.translate_string("st_arsenal_stashes_seen"), table.concat(names, ", ")))
    end
    -- the other ways it turns up; traders a row per tier, with what unlocks it and who
    local up = full and safe(arsenal_data.turns_up_model, shown.sec) or {}
    local sold = full and safe(arsenal_data.sold_by, shown.sec) or {}
    if #sold > 0 then
        local T = game.translate_string
        line(T("st_arsenal_sold_tiers"), "dim")
        for _, r in ipairs(sold) do
            local names = table.concat(r.traders, ", ")
            text("entry_line", r.need and string.format(T("st_arsenal_tier_need"), tostring(r.tier), need_text(r.need), names)
                or string.format(T("st_arsenal_tier"), tostring(r.tier), names))
        end
    elseif up.trader then
        line(game.translate_string("st_arsenal_sold_by"))
    end
    if fx.sold then
        local names = {}
        for n in pairs(fx.sold) do names[#names + 1] = n end
        table.sort(names)
        line(string.format(game.translate_string("st_arsenal_sold_at"), table.concat(names, ", ")))
    end
    if up.story then
        local names = {}
        for _, n in ipairs(up.story) do
            local t = game.translate_string(n)
            if t ~= n then names[#names + 1] = t end
        end
        names = distinct(names)
        line(#names > 0 and string.format(game.translate_string("st_arsenal_carried_story"), table.concat(names, ", "))
            or game.translate_string("st_arsenal_carried_story_some"))
    end
    if up.rolled then
        line(string.format(game.translate_string("st_arsenal_rolled"), table.concat(distinct(up.rolled), " / ")))
    end
    for _, w in ipairs({ { "corpse", "st_arsenal_in_bodies" }, { "task", "st_arsenal_from_tasks" },
        { "gift", "st_arsenal_from_gift" }, { "craft", "st_arsenal_from_craft" },
        { "homestead", "st_arsenal_from_homestead" } }) do
        if up[w[1]] then line(game.translate_string(w[2])) end
    end
    if full then
        -- the Armor Exchange: what its traders take for this suit first, then what they give for it
        local ex = armor and safe(arsenal_data.exchange, shown.sec)
        for _, x in ipairs(ex and ex.gets or {}) do
            line(string.format(game.translate_string("st_arsenal_exchange_gets"), table.concat(x.traders, ", "),
                tostring(x.count), tostring(x.cost), game.translate_string("st_faction_" .. x.faction)))
        end
        for _, x in ipairs(ex and ex.takes or {}) do
            line(string.format(game.translate_string("st_arsenal_exchange_takes"), table.concat(x.traders, ", "),
                x.name, tostring(x.cost), game.translate_string("st_faction_" .. x.faction)))
        end
        -- Nimble: what he takes for this gun first, then what he gives for it
        local from, gets = {}, {}
        for _, v in ipairs(e.variants) do
            local nb = safe(arsenal_data.nimble, v.sec)
            for _, t in ipairs(nb and nb.from or {}) do
                from[#from + 1] = string.format(game.translate_string("st_arsenal_nimble_from"),
                    table.concat(t.names, " / "), tostring(t.cost))
            end
            for _, t in ipairs(nb and nb.gets or {}) do
                gets[#gets + 1] = string.format(game.translate_string("st_arsenal_nimble_gets"), t.name,
                    tostring(t.cost))
            end
        end
        for _, list in ipairs({ distinct(from), distinct(gets) }) do
            for _, s in ipairs(list) do
                line(s)
            end
        end
        for _, mf in ipairs(safe(arsenal_data.made_from, shown.sec) or {}) do
            line(string.format(game.translate_string("st_arsenal_made_from"), mf.from, mf.kit))
        end
    end
    -- new-game kits: every faction's, or the player's own faction's as he knows it
    local mine = (not full) and fx.ways and fx.ways.kit and arsenal_intel.player_faction()
    for _, k in ipairs((full or mine) and safe(arsenal_data.starting_kits, shown.sec) or {}) do
        local has = full
        for _, f in ipairs(k.factions) do
            if f == mine then has = true end
        end
        if has then
            local who = factions_text(full and k.factions or { mine })
            local s = k.points and string.format(game.translate_string("st_arsenal_start_kit"), tostring(k.points), who)
                or string.format(game.translate_string("st_arsenal_start_free"), who)
            if k.economies then
                local ecos = {}
                for _, n in ipairs(k.economies) do ecos[#ecos + 1] = game.translate_string("st_econ_" .. n) end
                s = string.format(game.translate_string("st_arsenal_start_eco"), s, table.concat(ecos, ", "))
            end
            line(s)
        end
    end
    if not any then
        line(game.translate_string(full and "st_arsenal_no_source" or "st_arsenal_where_unknown"), "dim")
    end

    -- the variants, shown variant's first
    local order = { shown }
    for _, v in ipairs(e.variants) do
        if v ~= shown then order[#order + 1] = v end
    end
    -- A gun's rounds: the shown variant's, a row each with what it does from this gun (damage,
    -- AP, speed, damage left at 100 m) once the gun is studied, else by name; what only another
    -- variant chambers, and what an upgrade converts it to, by name under them
    local rounds = (e.cat ~= "ammo") and safe(arsenal_data.gun_rounds, shown.sec) or {}
    local mine, other = {}, {}
    for _, r in ipairs(rounds) do mine[r.name] = true end
    for i = 2, #order do
        for _, n in ipairs(safe(arsenal_data.ammo_names, order[i].sec) or {}) do
            if not mine[n] then other[#other + 1] = n end
        end
    end
    other = distinct(other)
    if #rounds > 0 or #other > 0 or #up_calibres > 0 then
        local T = game.translate_string
        y = y + GAP
        text("entry_heading", T("ui_ammo_types"))
        rule()
        local function round_row(name, cells, role)
            local n = xml:InitTextWnd("round_name", entry)
            n:SetWndPos(vector2():set(0, y))
            n:SetText(name)
            if role then n:SetTextColor(theme.argb(role)) end
            n:AdjustHeightToText()
            for i, s in ipairs(cells) do
                local c = xml:InitTextWnd("round_cell", entry)
                c:SetWndPos(vector2():set(ROUND_COLS[i], y))
                c:SetText(s)
                if role then c:SetTextColor(theme.argb(role)) end
            end
            y = y + n:GetHeight() + 2
        end
        if know and #rounds > 0 then
            round_row(T("st_arsenal_col_round"), { T("st_arsenal_col_damage"), T("st_arsenal_col_ap"),
                T("st_arsenal_col_speed"), T("st_arsenal_col_kept") }, "dim")
            for _, r in ipairs(rounds) do
                local dmg = r.pellets and string.format(T("st_arsenal_pellets"), tostring(r.damage), tostring(r.pellets))
                    or tostring(r.damage)
                round_row(r.name, { dmg, tostring(r.ap), tostring(r.speed), r.kept and percent(r.kept) or "-" })
            end
            text("entry_line", T("st_arsenal_rounds_note"), "dim")
        elseif #rounds > 0 then
            local names = {}
            for _, r in ipairs(rounds) do names[#names + 1] = r.name end
            text("entry_line", table.concat(distinct(names), ", "))
        end
        if #other > 0 then
            text("entry_line", string.format(T("st_arsenal_ammo_other"), table.concat(other, ", ")), "dim")
        end
        -- the ammo of another caliber an upgrade converts it to
        for _, c in ipairs(up_calibres) do
            text("entry_line", string.format(T("st_arsenal_ammo_by_upgrade"), c), "dim")
        end
    end

    -- what fits the gun and what it is made of, every variant's, shown variant's first; each
    -- item once, and each name once in a section (mods add items under a name already taken,
    -- GAMMA's two 1P29 Tyulpans); what a variant has built in, by name
    local fit = { scopes = {}, lasers = {}, kits = {}, suppressors = {}, launchers = {} }
    local builtin = { scope = {}, suppressor = {}, launcher = {}, laser = {} }
    local parts, seen = {}, {}
    local function add(list, kind, it)
        local key = kind .. "|" .. it.name
        if not seen[it.sec] and not seen[key] then
            seen[it.sec], seen[key] = true, true
            list[#list + 1] = it
        end
    end
    for _, v in ipairs(order) do
        local ok, a = pcall(arsenal_data.attachments, v.sec)
        if ok and a then
            for kind, list in pairs(fit) do
                for _, it in ipairs(a[kind] or {}) do
                    -- an addon that never turns up: left out while immersive, marked with the jailbreak
                    local up = not arsenal_data.addon_turns_up or arsenal_data.addon_turns_up(it.sec)
                    if up or not imm then
                        if not up then it.never = true end
                        add(list, kind, it)
                    end
                end
            end
            for k, names in pairs(builtin) do
                if a.builtin[k] then names[#names + 1] = v.name end
            end
        end
        local okp, ps = pcall(arsenal_data.parts, v.sec)
        for _, it in ipairs(okp and ps or {}) do
            add(parts, "parts", it)
        end
    end
    local function heading(id)
        y = y + GAP
        text("entry_heading", game.translate_string(id))
        rule()
    end
    -- a built-in note: plain when every variant has it, else naming the variants that do
    local function builtin_note(names, all_id, some_id)
        if #names == 0 then return end
        text("entry_line", #names == #e.variants and game.translate_string(all_id)
            or string.format(game.translate_string(some_id), table.concat(names, ", ")), "dim")
        y = y + 2
    end
    -- items as tiles, TILE_COLS to a row: the icon on a panel, the name under it, a note under
    -- that; a row is as tall as its tallest tile
    local function tiles(items)
        local col, row_h = 0, 0
        for i, it in ipairs(items) do
            local x = col * (TILE_W + TILE_GAP)
            local panel = xml:InitStatic("tile_icon_frame", entry)
            panel:SetWndPos(vector2():set(x, y))
            put_icon(xml, entry, panel, it.sec, TILE_PAD)
            local h = panel:GetHeight() + 2
            local t = xml:InitTextWnd("tile_name", entry)
            t:SetWndPos(vector2():set(x, y + h))
            t:SetText(it.name)
            t:AdjustHeightToText()
            h = h + t:GetHeight()
            local note = it.note
            if it.never then
                note = ((note and note ~= "") and (note .. "\\n") or "") .. game.translate_string("st_arsenal_addon_never")
            end
            if note and note ~= "" then
                local n = xml:InitTextWnd("tile_note", entry)
                n:SetWndPos(vector2():set(x, y + h))
                n:SetText(note)
                n:AdjustHeightToText()
                h = h + n:GetHeight()
            end
            row_h = math.max(row_h, h)
            col = col + 1
            if col == TILE_COLS or i == #items then
                y = y + row_h + GAP
                col, row_h = 0, 0
            end
        end
    end

    -- what fits it, its camos, parts and repair kits, once it is studied
    if know then
        -- magazines, when Mags Redux runs, each with its rounds
        local mags = {}
        for _, v in ipairs(order) do
            local ok, list = pcall(arsenal_data.mags, v.sec)
            for _, it in ipairs(ok and list or {}) do
                add(mags, "mags", it)
            end
        end
        if #mags > 0 then
            heading("st_arsenal_magazines")
            local mt = {}
            for _, it in ipairs(mags) do
                mt[#mt + 1] = { sec = it.sec, name = it.name,
                    note = string.format(game.translate_string("st_arsenal_rounds"), tostring(it.rounds)) }
            end
            tiles(mt)
        end

        if #fit.scopes > 0 or #builtin.scope > 0 then
            heading("st_arsenal_scopes")
            builtin_note(builtin.scope, "st_arsenal_builtin", "st_arsenal_builtin_on")
            tiles(fit.scopes)
        end
        -- a mount an upgrade adds says so under the item's name ("\\n": a line break in a text)
        local after = game.translate_string("st_arsenal_after_upgrade")
        if #fit.suppressors > 0 or #builtin.suppressor > 0 then
            heading("st_arsenal_suppressors")
            builtin_note(builtin.suppressor, "st_arsenal_builtin", "st_arsenal_builtin_on")
            local sup = {}
            for _, it in ipairs(fit.suppressors) do
                sup[#sup + 1] = { sec = it.sec, name = it.name, note = it.upgrade and after or nil, never = it.never }
            end
            tiles(sup)
        end
        -- launchers with the grenades they fire, laser modules, kits with the gun they make
        local acc = {}
        for _, it in ipairs(fit.launchers) do
            local note = table.concat(it.ammo or {}, ", ")
            if it.upgrade then
                note = (note ~= "" and (note .. "\\n") or "") .. after
            end
            acc[#acc + 1] = { sec = it.sec, name = it.name, note = note, never = it.never }
        end
        for _, it in ipairs(fit.lasers) do
            acc[#acc + 1] = { sec = it.sec, name = it.name, never = it.never }
        end
        for _, it in ipairs(fit.kits) do
            acc[#acc + 1] = { sec = it.sec, name = it.name,
                note = it.makes and string.format(game.translate_string("st_arsenal_makes"), it.makes), never = it.never }
        end
        if #acc > 0 or #builtin.launcher > 0 or #builtin.laser > 0 then
            heading("st_arsenal_accessories")
            builtin_note(builtin.launcher, "st_arsenal_builtin_gl", "st_arsenal_builtin_gl_on")
            builtin_note(builtin.laser, "st_arsenal_builtin_laser", "st_arsenal_builtin_laser_on")
            tiles(acc)
        end
        -- camos (3DSS's camo wheel), a row each: the swatch on a panel, the name (green once
        -- discovered, dim while not), and what it takes
        local camo_list = safe(arsenal_data.camos, shown.sec) or {}
        if #camo_list > 0 then
            heading("st_arsenal_camos")
            local ok, ratio = pcall(utils_xml.screen_ratio)
            ratio = ok and tonumber(ratio) or 1
            for _, c in ipairs(camo_list) do
                local panel = xml:InitStatic("part_icon_frame", entry)
                panel:SetWndPos(vector2():set(0, y))
                if c.icon then
                    local sw = xml:InitStatic("camo_swatch", entry)
                    local h = panel:GetHeight() - 2 * CAMO_PAD
                    local w = h * ratio
                    sw:InitTexture(c.icon)
                    sw:SetStretchTexture(true)
                    sw:SetWndSize(vector2():set(w, h))
                    sw:SetWndPos(vector2():set((panel:GetWidth() - w) / 2, y + CAMO_PAD))
                end
                local note
                if c.locked then
                    note = #c.factions > 0
                        and string.format(game.translate_string("st_arsenal_camo_locked_on"), factions_text(c.factions))
                        or game.translate_string("st_arsenal_camo_locked")
                elseif c.required then
                    note = game.translate_string("st_arsenal_camo_found")
                end
                local t = xml:InitTextWnd("part_name", entry)
                t:SetWndPos(vector2():set(t:GetWndPos().x, y + (note and 0 or PART_TEXT_DY)))
                t:SetText(c.name)
                if c.locked then
                    t:SetTextColor(theme.argb("dim"))
                elseif c.required then
                    t:SetTextColor(theme.argb("good"))
                end
                t:AdjustHeightToText()
                local h = t:GetHeight() + (note and 0 or PART_TEXT_DY)
                if note then
                    local n = xml:InitTextWnd("camo_note", entry)
                    n:SetWndPos(vector2():set(n:GetWndPos().x, y + h))
                    n:SetText(note)
                    n:AdjustHeightToText()
                    h = h + n:GetHeight()
                end
                y = y + math.max(panel:GetHeight(), h) + 4
            end
        end

        -- parts, a row each: the icon on a panel, the name beside it
        if #parts > 0 then
            heading("st_arsenal_parts")
            for _, it in ipairs(parts) do
                local panel = xml:InitStatic("part_icon_frame", entry)
                panel:SetWndPos(vector2():set(0, y))
                put_icon(xml, entry, panel, it.sec, TILE_PAD)
                local t = xml:InitTextWnd("part_name", entry)
                t:SetWndPos(vector2():set(t:GetWndPos().x, y + PART_TEXT_DY))
                t:SetText(it.name)
                t:AdjustHeightToText()
                y = y + math.max(panel:GetHeight(), t:GetHeight() + PART_TEXT_DY) + 4
            end
        end
        -- the kits that repair it, every variant's
        local kits = {}
        for _, v in ipairs(order) do
            for _, it in ipairs(safe(arsenal_data.repair_kits, v.sec) or {}) do
                add(kits, "repair", it)
            end
        end
        if #kits > 0 then
            heading("st_arsenal_repair_kits")
            tiles(kits)
        end
    end

    local descr = arsenal_data.description(shown.sec)
    if descr then
        y = y + GAP
        rule()
        text("entry_line", descr)
    end

    entry:SetWndSize(vector2():set(entry:GetWidth(), y + GAP))
    self.detail:AddWindow(entry, true)
    self.detail:ScrollToBegin()
end

function get_ui()
    SINGLETON = SINGLETON or ArsenalPDA()
    SINGLETON:Reset()
    return SINGLETON
end

-- Another app's button on Arsenal's model pages, such as Workbench's "Customize":
--     ui_arsenal.add_action("workbench", { label = "st_workbench_customize",
--         show = function(sec) return <whether it applies to this section> end,
--         run = function(sec) <open the app on that section> end })
-- `sec` is the section the page shows (the first found variant, else the first). The button
-- shows only on the pages it applies to, at most three apps' at once; adding an id again
-- replaces it.
function add_action(id, def)
    assert(type(id) == "string" and type(def) == "table" and type(def.run) == "function",
        "ui_arsenal.add_action(id, { label, show, run }): id a string, run a function")
    remove_action(id)
    actions[#actions + 1] = { id = id, label = def.label, show = def.show, run = def.run }
end

function remove_action(id)
    for i = #actions, 1, -1 do
        if actions[i].id == id then table.remove(actions, i) end
    end
end

-- the page in a window of its own (arsenal_mcm's key), when the player is up and about;
-- returns the window
function open_flat()
    if not (db.actor and db.actor:alive()) then return nil end
    FLAT = FLAT or ArsenalPDA(true)
    if not FLAT:IsShown() then
        FLAT:Reset()
        FLAT:ShowDialog(true)
    end
    return FLAT
end
