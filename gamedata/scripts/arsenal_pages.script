--[[
    Arsenal's three pages, each in a PDA section of its own as the PDA's tabs are: the catalog
    (eptArsenal, ui_arsenal), Workbench (eptWorkbench, ui_arsenal_workbench) and Compare
    (eptArsenalCompare, ui_arsenal_compare), and the switch between them, the plates at the top
    left of each.

    The catalog is reached from its tile in Mod App Creator's launcher (z_arsenal_mac), or from a
    tab of its own in the PDA's tab bar. Modded Exes' tab registry (pda_dynamic_tabs, since
    2026.7.31) adds the tab after the others, in the bar's own look, under a section of its own,
    which the catalog then opens in. The tab is there when MCM asks for it (arsenal_mcm.pda_tab)
    or MAC is not installed; otherwise, or without the registry, the tile. The registry rebuilds
    the live tab bar as a tab comes or goes. A tab added during a load (in on_game_start) crashed
    the game on 2026-10-11, and one added in play worked, so the tab comes and goes only in play:
    a moment after the first update, and once the game runs again after MCM's options change.

    The sections are claimed here by wrapping pda.set_active_subdialog as MAC wraps it (Seasons of
    the Zone's two pages do the same); every other section passes down untouched, and either wrap
    order works. The catalog's own section stays claimed, for its tile and other mods' calls. A
    page that fails to build is logged and comes back empty, so the PDA stays up.
--]]

PAGES = {
    catalog = { tab = "eptArsenal" },
    workbench = { tab = "eptWorkbench" },
    compare = { tab = "eptArsenalCompare" },
}

local function say(msg)
    printf("[arsenal] %s", tostring(msg))
end

-- the script of each page
local function script_of(page)
    if page == "workbench" then return ui_arsenal_workbench end
    if page == "compare" then return ui_arsenal_compare end
    return ui_arsenal
end

-- a page's window, or nothing (logged) when it fails to build
local function page_ui(page)
    local ok, ui = pcall(function() return script_of(page).get_ui() end)
    if ok then return ui end
    say("the " .. page .. " page failed to build: " .. tostring(ui))
    return nil
end

-- the catalog's tab: its caption, and the registry's section for it while it is there
local TAB_CAPTION = "st_arsenal_title"
local tab_section

-- whether this engine can give Arsenal a tab of its own: Modded Exes' registry, and AddTab on
-- the tab control
function tab_supported()
    return pda_dynamic_tabs ~= nil and type(pda_dynamic_tabs.register) == "function"
        and CUITabControl ~= nil and CUITabControl.AddTab ~= nil
end

-- whether the catalog has a tab of its own: MAC is not there for a tile, or MCM asks for it.
-- MAC is asked about first: MCM defines the option only with MAC, and logs a read of one no page
-- defines ("!MCM given bad path").
function wants_tab()
    return tab_supported() and (not (mac_mcm and mac_mcm.add_app) or arsenal_mcm.pda_tab()) or false
end

-- the section the catalog opens in: its tab's while it has one
function catalog_section()
    return tab_section or PAGES.catalog.tab
end

-- whether Back, in the PDA, goes to MAC's launcher: while the catalog has its tile there
function back_to_launcher()
    return z_arsenal_mac.has_tile() == true
end

-- A page's Back and the buttons left of it, as the layout places them (made with the page), and
-- each open: Back is there flat, where it closes the window, and in the PDA while it goes to the
-- launcher; without it the buttons move over into its place, ending where it ended.
function back_row(back, buttons)
    local row = { back = back, buttons = buttons, xs = {} }
    local right = 0
    for i, b in ipairs(buttons) do
        row.xs[i] = b:GetWndPos().x
        right = math.max(right, row.xs[i] + b:GetWidth())
    end
    row.shift = back:GetWndPos().x + back:GetWidth() - right
    return row
end

function show_back(row, flat)
    local back = flat or back_to_launcher()
    row.back:Show(back)
    for i, b in ipairs(row.buttons) do
        b:SetWndPos(vector2():set(row.xs[i] + (back and 0 or row.shift), b:GetWndPos().y))
    end
end

-- the section the PDA shows, or nil while it cannot be read
local function pda_section()
    local ok, s = pcall(function()
        local pda_menu = ActorMenu.get_pda_menu()
        return pda_menu and pda_menu:GetActiveSection()
    end)
    return ok and s or nil
end

-- The registry rebuilds the live tab bar as a tab comes or goes, and the engine then selects the
-- bar's pushed tab again when it is one of the registry's (CUIPdaWnd::RebuildExtraTabs), which
-- takes the PDA to that tab's own page: Seasons of the Zone's Forecast, reached from its tab,
-- gave way to its Year as the catalog's tab came, and Workbench to the catalog as Seasons' did.
-- So the section the PDA was on before, `was`, is put back, unless it was the tab taken away.
local function keep_section(was, gone)
    local pda_menu = ActorMenu.get_pda_menu()
    if pda_menu and was and was ~= "" and was ~= gone and pda_menu:GetActiveSection() ~= was then
        pda_menu:SetActiveSubdialog(was)
    end
end

-- The catalog's tab there or gone, as wants_tab() says, and MAC's tile the other way round; a
-- tab the registry refuses leaves the tile. With a tab taken away while it was the PDA's last
-- section, the PDA would reopen on a section nothing answers, its tab bar hidden; it goes to
-- Tasks, the PDA's own first page, instead. Any other section the PDA was on stays.
local function sync()
    local want = wants_tab()
    if want and not tab_section then
        local was = pda_section()
        local ok, id = pcall(pda_dynamic_tabs.register, TAB_CAPTION, function() return page_ui("catalog") end)
        if ok and type(id) == "string" then
            tab_section = id
            z_arsenal_mac.remove_tile()
        else
            say("no PDA tab of its own: " .. tostring(id))
            z_arsenal_mac.add_tile()
        end
        keep_section(was)
    elseif not want and tab_section then
        local was = pda_section()
        local id = tab_section
        tab_section = nil
        local ok, err = pcall(pda_dynamic_tabs.unregister, id)
        if not ok then say("the PDA tab could not be taken away: " .. tostring(err)) end
        z_arsenal_mac.add_tile()
        local pda_menu = ActorMenu.get_pda_menu()
        if pda_menu and pda_menu:GetActiveSection() == id then pda_menu:SetActiveSubdialog("eptTasks") end
        keep_section(was, id)
    end
end

-- sync, `delay` seconds into play (time events run with the actor's updates); a second call
-- before it runs changes nothing
local function sync_soon(delay)
    CreateTimeEvent("arsenal_pages", "sync_tab", delay, function()
        local ok, err = pcall(sync)
        if not ok then say("the PDA tab: " .. tostring(err)) end
        return true
    end)
end

-- Go to a page: in the PDA by its section; in the flat window (the MCM key) by swapping the
-- windows. `sec` and `id` pick Workbench's item (a model from the catalog by its section).
function open(page, sec, id)
    if page == "workbench" and (sec or id) then
        ui_arsenal_workbench.show_next(sec, id)
    end
    local any = false
    for _, p in ipairs({ "catalog", "workbench", "compare" }) do
        local w = script_of(p).flat_window()
        if w then
            w:Close()
            any = true
        end
    end
    if any then
        script_of(page).open_flat()
        return
    end
    local ok, err = pcall(function()
        ActorMenu.get_pda_menu():SetActiveSubdialog(page == "catalog" and catalog_section() or PAGES[page].tab)
    end)
    if not ok then say("could not open " .. tostring(page) .. ": " .. tostring(err)) end
end

-- the pages' sections to the pages; forwards every argument, not just the section, so a
-- signature upstream grows is not cut short
local wrapped = false
local function route()
    if wrapped or not (pda and pda.set_active_subdialog) then return end
    local orig = pda.set_active_subdialog
    pda.set_active_subdialog = function(section, ...)
        local page = (section == PAGES.catalog.tab and "catalog") or (section == PAGES.workbench.tab and "workbench")
            or (section == PAGES.compare.tab and "compare")
        if page then
            return page_ui(page)
        end
        return orig(section, ...)
    end
    wrapped = true
end

-- Fatal Error (fatal_error_mcm), when it runs, puts the PDA on error pages of its own while the
-- PDA is out of use, deciding as the PDA opens (process_pda_call). The flat window is the PDA's
-- page drawn sharp, so it opens only when the PDA would show the page. Its checks, in its order:
-- a PDA of the player's own in its slot (not an NPC's), charged and whole
-- (item_device.is_pda_charged), not encrypted, rebooting, in its BIOS or crashed; no emission
-- or psi storm, unless it was just rebooted (reboot_protection, a local of process_pda_call) or
-- is overclocked; not the Sarcophagus unless overclocked, nor a level the Monolith jams unless
-- the PDA has the upgrade against it, the player's faction is one the jam spares, or it is
-- overclocked. From 1.7.9.5 the Sarcophagus and the jam each have a switch on its MCM page
-- (SETTINGS.locs: secret_errors, monolith_hackers), on as it ships and before it had them.
-- Without Fatal Error the flat window always opens.
local JAM_FREE = { monolith = true, greh = true, zombied = true }
local SARCOPHAGUS = { l12u_sarcofag = true }
local warned = false

-- a local of another script, through its function fname that uses it, or the script's own field
-- of that name: an unlocalizer (Modded Exes' configs\unlocalizers) makes a local one, and the
-- function then holds no upvalue of it
local function script_local(mod, fname, name)
    if type(mod) ~= "table" then return nil end
    local fn = mod[fname]
    for i = 1, type(fn) == "function" and 255 or 0 do
        local n, v = debug.getupvalue(fn, i)
        if n == nil then break end
        if n == name then return v end
    end
    return rawget(mod, name)
end

-- whether the PDA would show its pages now; true without Fatal Error, or when its state cannot
-- be read (logged once)
function pda_works()
    local fe = fatal_error_mcm
    if not fe then return true end
    local ok, works = pcall(function()
        local device = db.actor:item_in_slot(8)
        if not device or device:section():find("itm_pda_") then return false end
        if not item_device.is_pda_charged(true) then return false end
        if ini_sys:r_bool_ex(device:section(), "encrypted") or (tonumber(fe.REBOOT) or 0) > 0 then return false end
        if ActorMenu.get_pda_menu():GetActiveSection() == "eptBios" then return false end
        if fe_utils.is_bsod(device) then return false end
        local overclocked = fe_utils.is_overclocked(device)
        local guard = tonumber(script_local(fe, "process_pda_call", "reboot_protection")) or 0
        if not (guard > 0 or overclocked) and (xr_conditions.surge_started() or psi_storm_manager.is_started()) then
            return false
        end
        local lvl = level.name()
        local locs = type(fe.SETTINGS) == "table" and type(fe.SETTINGS.locs) == "table" and fe.SETTINGS.locs or {}
        if SARCOPHAGUS[lvl] and locs.secret_errors ~= false and not overclocked then return false end
        if locs.monolith_hackers ~= false and (fe.MONOLITH_HACKERS or {})[lvl]
            and not (device:has_upgrade("up_seconc_pda") or JAM_FREE[get_actor_true_community()] or overclocked) then
            return false
        end
        return true
    end)
    if ok then return works == true end
    if not warned then
        warned = true
        say("Fatal Error's PDA state could not be read, so the flat window opens anyway: " .. tostring(works))
    end
    return true
end

-- Customize, on the catalog's gun, suit and helmet pages: Workbench on that model
local function customize(sec)
    open("workbench", sec)
end

local function add_customize()
    ui_arsenal.add_action("workbench", {
        label = "st_arsenal_wb_customize",
        show = arsenal_workbench.plannable,
        run = customize,
    })
end

function on_game_start()
    -- on_game_load, the moment MAC installs its own wrapper
    RegisterScriptCallback("on_game_load", route)
    -- the catalog's tab, in play only (above)
    RegisterScriptCallback("actor_on_first_update", function() sync_soon(1) end)
    RegisterScriptCallback("on_option_change", function() sync_soon(0) end)
    -- caught: the game starts every script in one pass, and an error would stop the rest
    local ok, err = pcall(add_customize)
    if not ok then say("no Customize on the catalog: " .. tostring(err)) end
end
