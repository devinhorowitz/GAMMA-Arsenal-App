--[[
    Arsenal's MCM page: a key that opens Arsenal flat, in a window of its own (ui_arsenal),
    whether guns the player only sees count, and the jailbreak, which lists everything the game
    has (Arsenal otherwise lists what the player has learned of: arsenal_intel). With the 3D PDA
    on, the PDA's pages are drawn onto the in-hand screen, which softens them; the flat window is
    drawn straight to the screen, as sharp as the inventory. The key is unbound (-1) until the
    player picks one; the PDA tile works either way. A modifier (MCM's own Shift, Ctrl or Alt
    picker) can be asked for with it; with none, the key opens Arsenal whatever else is held, as a
    sprinting player's Shift. With Fatal Error, the key opens Arsenal only
    while its PDA works (arsenal_pages.pda_works). With Mod App Creator and Modded Exes' tab
    registry, "Arsenal tab in the PDA" gives the catalog a tab of its own instead of its tile; off
    until the player turns it on. Seen guns and the jailbreak are off until the
    player turns them on. PDA notifications are on until the player silences them, here or with
    the Silence box at the foot of Arsenal's pages, which writes the same option. "Show where
    items are defined" ends each model's page with the files the game read it from
    (arsenal_sources), for modders; off until the player turns it on.
--]]

-- The release and its author, on the line at the foot of every page, so a screenshot says which
-- Arsenal it shows. build.py refuses to build while VERSION is not its own.
VERSION = "1.8.2"
AUTHOR = "Windwalker"

-- whether there is a PDA tab of Arsenal's own to choose over MAC's tile: MAC is installed, and
-- the engine has the tab registry (arsenal_pages.tab_supported). Without MAC the tab is there
-- anyway, and without the registry the tile.
local function tab_choice()
    local ok, v = pcall(function() return mac_mcm ~= nil and mac_mcm.add_app ~= nil and arsenal_pages.tab_supported() end)
    return ok and v == true
end

function on_mcm_load()
    local page = {
        id = "arsenal",
        sh = true,
        gr = {
            { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_menu_arsenal",
              size = { 512, 50 }, spacing = 20 },
            { id = "flat_key", type = "key_bind", val = 2, def = -1 },
            -- MCM's template for a key's modifier, with MCM's own strings
            { id = "flat_mod", type = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h", val = 2, def = 0,
              hint = "mcm_kb_modifier", content = { { 0, "mcm_kb_mod_none" }, { 1, "mcm_kb_mod_shift" },
                  { 2, "mcm_kb_mod_ctrl" }, { 3, "mcm_kb_mod_alt" } } },
            { id = "count_seen", type = "check", val = 1, def = false },
            { id = "jailbreak", type = "check", val = 1, def = false },
            { id = "news", type = "check", val = 1, def = true },
            { id = "sources", type = "check", val = 1, def = false },
            { id = "about", type = "desc", text = "ui_mcm_arsenal_about" },
        },
    }
    -- after the key and its modifier, the other way into Arsenal
    if tab_choice() then
        table.insert(page.gr, 4, { id = "pda_tab", type = "check", val = 1, def = false })
    end
    return page
end

-- the key that opens Arsenal flat, or nil while it is unbound or MCM is missing
function flat_key()
    local ok, k = pcall(function() return ui_mcm and ui_mcm.get("arsenal/flat_key") end)
    k = ok and tonumber(k)
    return (k and k >= 0) and k or nil
end

-- the modifier asked for with the key: 0 none, 1 Shift, 2 Ctrl, 3 Alt; none while unset or
-- MCM is missing
function flat_mod()
    local ok, m = pcall(function() return ui_mcm and ui_mcm.get("arsenal/flat_mod") end)
    m = ok and tonumber(m)
    return (m and m >= 1 and m <= 3) and m or 0
end

-- whether the modifier asked for is held (MCM tracks Shift, Ctrl and Alt). With none asked for,
-- any is fine; an MCM without the helper asks for none.
local function mod_held()
    local m = flat_mod()
    if m == 0 then return true end
    local ok, held = pcall(function() return ui_mcm.get_mod_key(m) end)
    return not ok or held == true
end

-- whether the catalog has a tab of its own in the PDA's tab bar instead of its tile in MAC's
-- launcher; false while the option is off, or not offered (no MAC), or MCM is missing.
-- arsenal_pages.wants_tab decides what the PDA gets.
function pda_tab()
    local ok, v = pcall(function() return ui_mcm and ui_mcm.get("arsenal/pda_tab") end)
    return (ok and v == true) or false
end

-- whether the guns in a body, stash or trader's stock count when their window opens; false
-- while the option is off or MCM is missing
function count_seen()
    local ok, v = pcall(function() return ui_mcm and ui_mcm.get("arsenal/count_seen") end)
    return ok and v == true
end

-- whether the jailbreak is on: Arsenal lists everything; false while it is off or MCM is missing
function jailbreak()
    local ok, v = pcall(function() return ui_mcm and ui_mcm.get("arsenal/jailbreak") end)
    return (ok and v == true) or false
end

-- whether Arsenal's PDA messages are on: true unless the player silenced them
function news()
    local ok, v = pcall(function() return ui_mcm and ui_mcm.get("arsenal/news") end)
    return not (ok and v == false)
end

-- whether each model's page ends with where the game read it from (arsenal_sources); false while
-- the option is off or MCM is missing
function sources()
    local ok, v = pcall(function() return ui_mcm and ui_mcm.get("arsenal/sources") end)
    return (ok and v == true) or false
end

-- the Silence box writes the option rather than keeping a copy, so it and MCM are one setting
function set_news(on)
    local ok, err = pcall(function() ui_mcm.set("arsenal/news", on and true or false) end)
    if not ok then printf("[arsenal] could not set PDA notifications: %s", tostring(err)) end
end

-- Every PDA message Arsenal sends goes through here, under Arsenal's name and the PDA's
-- "received" icon. Silenced, it is dropped rather than held for later; the log still has it.
-- Returns whether it was sent.
function tell(text)
    if not news() then
        printf("[arsenal] PDA (silenced): %s", tostring(text))
        return false
    end
    if not db.actor then return false end
    db.actor:give_game_news(game.translate_string("st_arsenal_title"), text,
        "ui_inGame2_Predmet_poluchen", 0, 5000, 0)
    return true
end

-- the line at the foot of every page: the app's name, VERSION and AUTHOR (st_arsenal_credit)
function credit()
    return string.format(game.translate_string("st_arsenal_credit"), VERSION, AUTHOR)
end

-- the key opens Arsenal flat, when the PDA would show it (arsenal_pages.pda_works: Fatal Error's
-- PDA out of use); else a line on the HUD says why not. The window opens on the next update, not
-- during the press: the engine hands a key to scripts before the UI (Level_input.cpp), so a
-- window opened here gets this same press, and the key closes it. While a page is open flat the
-- press is that page's to close it (OnKeyboard), so this leaves it alone.
local function on_key_press(key)
    local k = flat_key()
    if not (k and key == k) then return end
    if not mod_held() then return end
    if ui_arsenal.flat_window() or ui_arsenal_workbench.flat_window() or ui_arsenal_compare.flat_window() then return end
    if not arsenal_pages.pda_works() then
        actor_menu.set_msg(1, game.translate_string("st_arsenal_pda_down"), 3)
        return
    end
    CreateTimeEvent("arsenal_mcm", "open_flat", 0, function()
        ui_arsenal.open_flat()
        return true
    end)
end

-- A page open flat is a window Lua made, shown with ShowDialog. A load (a quickload while it is
-- open) restarts the scripts and frees it while the engine still holds it, and the next frame
-- draws freed memory: the crash at AnomalyDX11AVX.exe+0x215C52, as Immersive Identification's
-- tag dialog did. So every page open flat closes when the level goes.
local function close_flat()
    for _, m in ipairs({ ui_arsenal, ui_arsenal_workbench, ui_arsenal_compare }) do
        local ok, w = pcall(function() return m.flat_window() end)
        if ok and w then pcall(function() w:Close() end) end
    end
end

function on_game_start()
    RegisterScriptCallback("on_key_press", on_key_press)
    RegisterScriptCallback("actor_on_net_destroy", close_flat)
end
